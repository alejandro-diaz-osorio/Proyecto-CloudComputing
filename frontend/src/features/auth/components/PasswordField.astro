---
import Field from './Field.astro';
import InputBox from './InputBox.astro';
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  placeholder?: string;
  autocomplete?: string;
  hintId?: string;
}
const { id, name, label, placeholder, autocomplete, hintId } = Astro.props;
---
<Field id={id} name={name} label={label}>
  <Fragment slot="aside"><slot name="aside" /></Fragment>
  <InputBox
    id={id}
    name={name}
    type="password"
    placeholder={placeholder}
    autocomplete={autocomplete}
    aria-describedby={hintId}
    icon="lock"
  >
    <button
      slot="trailing"
      type="button"
      class="auth-input__toggle"
      data-toggle-password
      aria-label="Mostrar contraseña"
      aria-pressed="false"
    >
      <Icon name="eye" data-eye="show" />
      <Icon name="eye-off" data-eye="hide" hidden />
    </button>
  </InputBox>
</Field>

<script>
  // Un solo listener delegado para todos los campos de contraseña de la página.
  document.addEventListener('click', (e) => {
    const boton = (e.target as Element).closest<HTMLButtonElement>('[data-toggle-password]');
    if (!boton) return;
    const input = boton.closest('.auth-input')?.querySelector('input');
    if (!input) return;

    const visible = input.type === 'password';
    input.type = visible ? 'text' : 'password';
    boton.setAttribute('aria-pressed', String(visible));
    boton.setAttribute('aria-label', visible ? 'Ocultar contraseña' : 'Mostrar contraseña');
    boton.querySelector('[data-eye="show"]')?.toggleAttribute('hidden', visible);
    boton.querySelector('[data-eye="hide"]')?.toggleAttribute('hidden', !visible);
  });
</script>
