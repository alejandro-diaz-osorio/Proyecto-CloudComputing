---
type Nombre = 'mail' | 'lock' | 'user' | 'eye' | 'eye-off' | 'arrow-right' | 'user-plus' | 'shield';

interface Props {
  name: Nombre;
  size?: number;
  [atributo: string]: any;
}

const { name, size, ...rest } = Astro.props;

const FORMAS: Record<Nombre, string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 7 8.5 6 8.5-6" />',
  lock: '<rect x="4.5" y="10.5" width="15" height="10" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" />',
  user: '<circle cx="12" cy="8.5" r="3.7" /><path d="M4.5 20c.9-3.6 3.8-5.5 7.5-5.5s6.6 1.9 7.5 5.5" />',
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12Z" /><circle cx="12" cy="12" r="2.8" />',
  'eye-off':
    '<path d="M3 3l18 18" /><path d="M10.6 5.7A9.6 9.6 0 0 1 12 5.5c6 0 9.5 6.5 9.5 6.5a16 16 0 0 1-3.2 4M6.5 7.2A15.6 15.6 0 0 0 2.5 12S6 18.5 12 18.5c1.4 0 2.6-.3 3.7-.8" /><path d="M9.9 9.9a3 3 0 0 0 4.2 4.2" />',
  'arrow-right': '<path d="M4 12h16M14 6l6 6-6 6" />',
  'user-plus': '<circle cx="10" cy="8.5" r="3.7" /><path d="M3.5 20c.8-3.5 3.3-5.3 6.5-5.3M18 9v6M15 12h6" />',
  shield: '<path d="M12 3.2 5 6v5.5c0 4.3 2.9 7.6 7 9.3 4.1-1.7 7-5 7-9.3V6l-7-2.8Z" /><path d="m9 12 2.2 2.2L15.2 10" />',
};

const tamano = size ?? (name === 'shield' ? 16 : 20);
---
<svg
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  {...rest}
><Fragment set:html={FORMAS[name]} /></svg>
