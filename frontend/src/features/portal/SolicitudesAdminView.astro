---
import { Search, X, Paperclip, ChevronLeft, ChevronRight, Mail, MapPin, FileText, Send, Lock, Download } from '@lucide/astro';
---

<section class="min-w-0 text-(--p-ink)">
  <div class="mb-7">
    <p class="mb-1.5 text-[10px] font-bold uppercase tracking-[.14em] text-(--p-accent)">Panel de gestión</p>
    <h1 class="m-0 text-[clamp(1.9rem,3vw,2.6rem)] font-extrabold uppercase leading-[1.1] tracking-[-.01em]">Solicitudes de cotización</h1>
    <p class="mt-1.5 text-[13px] text-(--p-muted)">Evalúa proyectos y responde a tus clientes desde un solo lugar.</p>
  </div>

  <p class="p-4 text-[13px] text-(--p-muted)" id="adm-msg" role="status">Cargando solicitudes…</p>

  <div class="grid grid-cols-1 items-start gap-4.5 xl:grid-cols-[minmax(0,1fr)_380px]" id="adm-cuerpo" hidden>
    <div class="min-w-0 border border-(--p-line) bg-(--p-card)">
      <header class="flex flex-wrap items-center justify-between gap-3 border-b border-(--p-line) px-5 py-3.5 max-md:p-3.5">
        <div class="flex flex-wrap gap-1" id="adm-tabs" role="group" aria-label="Filtrar por estado">
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="todas" aria-pressed="true">Todas</button>
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="enviada" aria-pressed="false">
            Nuevas <span class="inline-grid h-4.5 min-w-4.5 place-items-center rounded-full bg-(--p-accent) px-1.25 text-2.25 font-bold text-white" id="adm-badge" hidden>0</span>
          </button>
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="evaluacion" aria-pressed="false">En evaluación</button>
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="rechazada" aria-pressed="false">Rechazadas</button>
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="respondida" aria-pressed="false">Respondidas</button>
          <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border-0 bg-transparent px-3.5 py-2.25 text-[11px] font-semibold text-(--p-ink) hover:bg-[#f3efe6] aria-pressed:bg-[#f9e3df] aria-pressed:text-(--p-accent) motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-filtro="confirmada" aria-pressed="false">Confirmadas</button>
        </div>
        <label class="flex h-9.5 w-60 max-w-full items-center gap-2 rounded border border-(--p-line) bg-white px-3 text-(--p-muted) focus-within:border-(--p-accent) max-md:w-full">
          <Search size={16} stroke-width={1.6} />
          <input class="min-w-0 flex-1 border-0 bg-transparent font-[inherit] text-[12px] text-(--p-ink) outline-0" type="search" id="adm-buscar" placeholder="Buscar solicitud…" autocomplete="off" aria-label="Buscar solicitud" />
        </label>
      </header>

      <div class="hidden grid-cols-[minmax(0,1.1fr)_minmax(0,1.3fr)_112px_118px] items-center gap-4 border-b border-(--p-line) px-5 py-3 text-2.25 font-bold uppercase tracking-[.08em] text-(--p-muted) md:grid" aria-hidden="true">
        <span>Solicitud / Cliente</span><span>Proyecto</span><span>Fecha</span><span>Estado</span>
      </div>
      <div id="adm-lista"></div>

      <footer class="flex flex-wrap items-center justify-between gap-3 px-5 py-3.5">
        <small class="text-[11px] text-(--p-muted)" id="adm-rango">&nbsp;</small>
        <nav class="flex" id="adm-pager" aria-label="Paginación"></nav>
      </footer>
    </div>

    <aside class="sticky top-21.5 max-h-[calc(100vh-102px)] min-w-0 overflow-y-auto border border-(--p-line) bg-(--p-card) max-xl:static max-xl:max-h-none max-xl:overflow-visible" id="adm-detalle" aria-live="polite"></aside>
  </div>

  <!-- Íconos Lucide para el HTML que se pinta desde JS -->
  <template id="ico-pin"><MapPin size={12} stroke-width={1.8} /></template>
  <template id="ico-mail"><Mail size={12} stroke-width={1.8} /></template>
  <template id="ico-clip"><Paperclip size={18} stroke-width={1.6} /></template>
  <template id="ico-file"><FileText size={18} stroke-width={1.6} /></template>
  <template id="ico-down"><Download size={18} stroke-width={1.6} /></template>
  <template id="ico-send"><Send size={16} stroke-width={1.8} /></template>
  <template id="ico-lock"><Lock size={16} stroke-width={1.6} /></template>
  <template id="ico-x"><X size={18} stroke-width={1.6} /></template>
  <template id="ico-prev"><ChevronLeft size={16} stroke-width={1.8} /></template>
  <template id="ico-next"><ChevronRight size={16} stroke-width={1.8} /></template>
</section>

<script>
  import { initSession, getSesion, suscribirSesion } from '../auth/session.js';
  import {
    listarSolicitudesAdmin,
    detalleSolicitudAdmin,
    tomarSolicitud,
    rechazarSolicitud,
    subirPropuestaPdf,
    descargarArchivo,
    crearCotizacion,
    actualizarCotizacion,
    enviarCotizacion,
    ESTADOS,
  } from './api.js';

  initSession(); // idempotente: este script corre antes que el del layout

  type Estado = keyof typeof ESTADOS;
  type Solicitud = {
    id: string | number;
    codigo: string;
    titulo: string;
    tipoProyecto: string;
    descripcion: string;
    ubicacion: string;
    servicio: string;
    clienteId: string | number | null;
    cliente: string | null;
    clienteEmail: string;
    area: string;
    presupuesto: string;
    plazoInicio: string;
    estado: Estado;
    fecha: string;
    creada: number | null;
    orden: number;
  };
  type Archivo = {
    id: string | number;
    nombre: string;
    categoria: string;
    tamano: string;
  };
  type Cotizacion = {
    id: string | number;
    estado: string;
    version: number;
    titulo: string;
    valor: number;
    moneda: string;
    vigencia: number | null;
    ivaIncluido: boolean | null;
    descripcion: string;
    archivoId: string | number | null;
    enviada: string;
    vence: string;
  };
  type SolicitudDetalle = Solicitud & {
    archivos: Archivo[];
    cotizacion: Cotizacion | null;
    borrador: Cotizacion | null;
  };
  type EstadoDetalle = 'cargando' | 'error' | 'ok';
  type RespuestaId = {
    id?: string | number | null;
    archivo?: { id?: string | number | null };
    cotizacion?: { id?: string | number | null };
  };

  const POR_PAGINA = 8;

  const $ = <T extends HTMLElement>(id: string): T => {
    const element = document.querySelector<T>(`#${id}`);
    if (!element) throw new Error(`No se encontró el elemento #${id}.`);
    return element;
  };
  const esc = (t: unknown): string => {
    const entidades: Record<string, string> = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#39;',
    };
    return String(t ?? '').replace(/[&<>"']/g, (c) => entidades[c] ?? c);
  };
  const ico = (n: string): string => $<HTMLTemplateElement>(`ico-${n}`).innerHTML;
  const norm = (t: unknown): string => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const mensajeError = (err: unknown, fallback: string): string =>
    err instanceof Error ? err.message : fallback;

  const msg = $<HTMLParagraphElement>('adm-msg');
  const cuerpo = $<HTMLDivElement>('adm-cuerpo');
  const listaEl = $<HTMLDivElement>('adm-lista');
  const detalleEl = $<HTMLElement>('adm-detalle');
  const pagerEl = $<HTMLElement>('adm-pager');
  const rangoEl = $<HTMLElement>('adm-rango');
  const badgeEl = $<HTMLSpanElement>('adm-badge');
  const tabsEl = $<HTMLDivElement>('adm-tabs');
  const buscarEl = $<HTMLInputElement>('adm-buscar');

  let todas: Solicitud[] = [];
  let activa: Solicitud | null = null;
  let filtro = 'todas';
  let texto = '';
  let pagina = 1;
  let cargado = false;
  const cache = new Map<string | number, SolicitudDetalle>(); // solicitudId -> detalle

  const CATEGORIAS: Record<string, string> = { referencia: 'Referencia', plano: 'Plano' };
  const ESTADOS_COT: Record<string, string> = { borrador: 'Borrador', vigente: 'Vigente', reemplazada: 'Reemplazada', confirmada: 'Confirmada' };
  const TONO_CLASES: Record<string, string> = {
    accent: 'bg-[#f9e3df] text-(--p-accent)',
    warn: 'bg-[#f3ead4] text-[#8a6a1f]',
    ok: 'bg-[#dcebe2] text-[#2f6b4a]',
    info: 'bg-[#e4ecf5] text-[#3f6aa0]',
  };

  const fmtMoneda = (n: number, moneda = 'COP') =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: moneda, maximumFractionDigits: 0 }).format(n);
  // Cotizaciones creadas en un intento de envío que falló a medias: se reutilizan al reintentar.
  const intentos = new Map<string, { id: string | number | null; archivoId: string | number | null }>(); // solicitudId -> { id: cotizacionId, archivoId }

  const nombreDe = (s: Solicitud): string => s.cliente ?? `Cliente #${s.clienteId ?? '—'}`;
  const inicialesDe = (s: Solicitud): string => {
    if (!s.cliente) return 'CL';
    const p = s.cliente.split(/\s+/).filter(Boolean);
    return ((p[0]?.[0] ?? '') + (p[1]?.[0] ?? '')).toUpperCase() || 'CL';
  };
  const estadoDe = (s: Solicitud) => ESTADOS[s.estado] ?? ESTADOS.enviada;
  const pill = (s: Solicitud, big = false): string => {
    const e = estadoDe(s);
    return `<span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-2.5 py-[3px] text-[10px] font-semibold ${TONO_CLASES[e.tono]} ${big ? 'ml-auto self-start px-3 py-1.25 max-md:ml-0' : ''}"><i class="h-1.25 w-1.25 rounded-full bg-current"></i>${e.label}</span>`;
  };

  function mensaje(texto: string) {
    msg.hidden = false;
    msg.textContent = texto;
  }

  // ── Filtrado y lista ───────────────────────────────────────────────────
  function visibles(): Solicitud[] {
    const q = norm(texto.trim());
    return todas.filter((s) => {
      if (filtro !== 'todas' && s.estado !== filtro) return false;
      if (!q) return true;
      return norm([s.codigo, s.titulo, nombreDe(s), s.clienteEmail, s.ubicacion].join(' ')).includes(q);
    });
  }

  function pintarBadge() {
    const nuevas = todas.filter((s) => s.estado === 'enviada').length;
    badgeEl.hidden = nuevas === 0;
    badgeEl.textContent = String(nuevas);
  }

  function filaHtml(s: Solicitud): string {
    return `
      <button type="button" class="relative grid w-full grid-cols-[minmax(0,1fr)_auto] gap-x-3 gap-y-2.5 border-x-0 border-t-0 border-b border-(--p-line) bg-transparent px-5 py-4 text-left [grid-template-areas:'who_state'_'proj_proj'_'date_date'] [font:inherit] text-inherit hover:bg-[#f8f5ee] aria-[current=true]:bg-[#f3efe6] aria-[current=true]:before:absolute aria-[current=true]:before:bottom-0 aria-[current=true]:before:left-0 aria-[current=true]:before:top-0 aria-[current=true]:before:w-[3px] aria-[current=true]:before:bg-(--p-accent) aria-[current=true]:before:content-[''] motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent) md:grid-cols-[minmax(0,1.1fr)_minmax(0,1.3fr)_112px_118px] md:gap-4 md:[grid-template-areas:none]" data-id="${esc(s.id)}" aria-current="${s.id === activa?.id}">
        <span class="[grid-area:who] flex min-w-0 items-center gap-3 md:[grid-area:auto]">
          <span class="grid h-8 w-8 flex-none place-items-center rounded-full bg-[#ece8df] text-[10px] font-bold text-(--p-ink)">${esc(inicialesDe(s))}</span>
          <span class="flex min-w-0 flex-col gap-[3px]"><strong class="break-words text-[12px] font-semibold">${esc(nombreDe(s))}</strong><small class="text-[11px] tracking-[.08em] text-(--p-muted)">${esc(s.codigo)}</small></span>
        </span>
        <span class="[grid-area:proj] flex min-w-0 flex-col gap-[3px] md:[grid-area:auto]"><strong class="break-words text-[12px] font-semibold">${esc(s.titulo)}</strong><small class="text-[11px] text-(--p-muted)">${esc(s.servicio)}</small></span>
        <span class="[grid-area:date] text-[11px] text-(--p-muted) md:[grid-area:auto]">${esc(s.fecha)}</span>
        <span class="[grid-area:state] md:[grid-area:auto]">${pill(s)}</span>
      </button>`;
  }

  function pintarPaginador(paginas: number) {
    if (paginas <= 1) {
      pagerEl.innerHTML = '';
      return;
    }
    const ini = Math.max(1, Math.min(pagina - 2, paginas - 4));
    const fin = Math.min(paginas, ini + 4);
    const paginaClase = 'ml-[-1px] grid h-8 min-w-8 cursor-pointer place-items-center border border-(--p-line) bg-white px-1.5 text-[11px] enabled:hover:bg-[#f3efe6] disabled:cursor-not-allowed disabled:opacity-45 aria-[current=page]:border-[var(--p-accent)] aria-[current=page]:bg-(--p-accent) aria-[current=page]:font-bold aria-[current=page]:text-white motion-safe:transition-[background-color] motion-safe:duration-150 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)';
    let html = `<button type="button" class="${paginaClase}" data-pag="${pagina - 1}" aria-label="Página anterior" ${pagina === 1 ? 'disabled' : ''}>${ico('prev')}</button>`;
    for (let p = ini; p <= fin; p++) {
      html += `<button type="button" class="${paginaClase}" data-pag="${p}" ${p === pagina ? 'aria-current="page"' : ''}>${p}</button>`;
    }
    html += `<button type="button" class="${paginaClase}" data-pag="${pagina + 1}" aria-label="Página siguiente" ${pagina === paginas ? 'disabled' : ''}>${ico('next')}</button>`;
    pagerEl.innerHTML = html;
  }

  function pintarLista() {
    const filas = visibles();
    const total = filas.length;
    const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
    pagina = Math.min(pagina, paginas);
    const desde = (pagina - 1) * POR_PAGINA;
    const pag = filas.slice(desde, desde + POR_PAGINA);

    listaEl.innerHTML = pag.length
      ? pag.map(filaHtml).join('')
      : `<p class="m-0 px-5 py-7 text-[12px] text-(--p-muted)">${todas.length ? 'Ninguna solicitud coincide con tu búsqueda.' : 'Aún no hay solicitudes enviadas.'}</p>`;

    rangoEl.textContent = total
      ? `Mostrando ${desde + 1}–${desde + pag.length} de ${total} solicitud${total === 1 ? '' : 'es'}`
      : '\u00a0';
    pintarPaginador(paginas);
  }

  // ── Detalle ────────────────────────────────────────────────────────────
  // El detalle viene de otro endpoint: lo que ya conocemos de la lista se conserva si falta allí.
  function unir(s: Solicitud, d: SolicitudDetalle | null): Solicitud | SolicitudDetalle {
    if (!d) return s;
    return {
      ...s,
      ...d,
      cliente: d.cliente ?? s.cliente,
      clienteEmail: d.clienteEmail || s.clienteEmail,
      servicio: d.servicio !== '—' ? d.servicio : s.servicio,
    };
  }

  // Fila de archivo con descarga (la ruta exige sesión, por eso es un botón y no un enlace).
  function htmlArchivo(a: Archivo, detalle: (string | null | undefined)[], quote = false): string {
    return `
      <button type="button" class="group mb-2 flex w-full items-center gap-3 border border-(--p-line) bg-white p-3 text-left [font:inherit] text-inherit enabled:hover:bg-[#f8f5ee] disabled:cursor-progress disabled:opacity-70 ${quote ? 'mt-[10px] mb-0' : ''} focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-descargar="${esc(a.id)}" aria-label="Descargar ${esc(a.nombre)}">
        <span class="grid flex-none text-(--p-muted)">${ico('clip')}</span>
        <span class="flex min-w-0 flex-1 flex-col gap-[3px]"><strong class="break-words text-[12px] font-semibold">${esc(a.nombre)}</strong><small class="text-[11px] text-(--p-muted)">${esc(detalle.filter(Boolean).join(' · '))}</small></span>
        <span class="grid flex-none text-(--p-muted) group-hover:text-(--p-accent)">${ico('down')}</span>
      </button>`;
  }

  function htmlArchivos(d: SolicitudDetalle | null, estado: EstadoDetalle): string {
    if (estado === 'cargando') return `<p class="mb-4.5 text-[12px] text-(--p-muted)">Cargando archivos…</p>`;
    if (estado === 'error') return `<p class="mb-4.5 text-[12px] text-(--p-accent)">No pudimos cargar los archivos.</p>`;
    // Los archivos de categoría "cotizacion" son de la administración, no del cliente.
    const archivos = (d?.archivos ?? []).filter((a) => a.categoria !== 'cotizacion');
    if (!archivos.length) return `<p class="mb-4.5 text-[12px] text-(--p-muted)">El cliente no adjuntó archivos.</p>`;
    return archivos.map((a) => htmlArchivo(a, [CATEGORIAS[a.categoria] ?? a.categoria, a.tamano])).join('');
  }

  function htmlQuote(c: Cotizacion, d: SolicitudDetalle | null): string {
    const valor = Number.isFinite(c.valor) ? fmtMoneda(c.valor, c.moneda) : '—';
    const pdf = c.archivoId ? (d?.archivos ?? []).find((a) => String(a.id) === String(c.archivoId)) : null;
    const meta: [string, string][] = [];
    if (c.enviada) meta.push(['Enviada el', c.enviada]);
    if (c.vence) meta.push(['Válida hasta', c.vence]);
    return `
      <div class="border border-[#ecd2cc] bg-[#fbf1ee] p-4">
        <div class="flex items-center gap-3 border-b border-[#ecd2cc] pb-3.5">
          <span class="grid h-9 w-9 flex-none place-items-center rounded bg-(--p-accent) text-white">${ico('file')}</span>
          <span class="flex min-w-0 flex-1 flex-col gap-[3px]">
            <strong class="break-words text-[12px] font-semibold">${esc(c.titulo)}${c.version > 1 ? ` · versión ${esc(c.version)}` : ''}</strong>
            <small class="text-[11px] text-(--p-muted)">${esc([
              ESTADOS_COT[c.estado] ?? c.estado,
              c.vigencia ? `Vigencia de ${c.vigencia} días` : '',
              c.ivaIncluido === true ? 'IVA incluido' : c.ivaIncluido === false ? 'Más IVA' : '',
            ].filter(Boolean).join(' · '))}</small>
          </span>
        </div>
        <div class="flex flex-col gap-1 pt-3.5"><small class="text-[11px] text-(--p-muted)">Valor de la propuesta</small><strong class="text-[22px] font-extrabold">${esc(valor)}</strong></div>
        ${meta.length ? `<dl class="mt-3.5 grid grid-cols-2 gap-x-5 gap-y-3.5 border-t border-[#ecd2cc] pt-3.5 max-md:grid-cols-1">${meta.map(([k, t]) => `<div><dt class="mb-[3px] text-[10px] text-(--p-muted)">${k}</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(t)}</dd></div>`).join('')}</dl>` : ''}
        ${c.descripcion ? `<p class="mt-3 whitespace-pre-line text-[11px] leading-[1.6] text-(--p-muted)">${esc(c.descripcion)}</p>` : ''}
      </div>
      ${pdf ? htmlArchivo(pdf, ['Propuesta en PDF', pdf.tamano], true) : ''}`;
  }

  // Formulario "Preparar cotización": solo con la solicitud En evaluación y sin cotización enviada.
  function htmlPreparar(v: Solicitud, d: SolicitudDetalle | null): string {
    const c = d?.borrador ?? null;
    const valor = c && Number.isFinite(c.valor) ? c.valor : '';
    const pdfPrevio = c?.archivoId ? (d?.archivos ?? []).find((a) => String(a.id) === String(c.archivoId)) : null;
    const iva = c?.ivaIncluido === false ? '0' : '1';
    return `
      <form id="adm-form" novalidate data-solicitud="${esc(v.id)}" data-cotizacion="${esc(c?.id ?? '')}" data-archivo="${esc(c?.archivoId ?? '')}">
        <h3 class="mb-4.5 flex items-center gap-2.5 text-[13px] font-bold uppercase tracking-[.02em]"><span class="text-[10px] text-(--p-accent)">02</span> Preparar cotización</h3>
        ${c ? `<p class="mb-4.5 text-[12px] text-(--p-muted)">Hay un borrador guardado: puedes completarlo y enviarlo.</p>` : ''}

        <div class="mb-4 flex min-w-0 flex-col gap-1.5">
          <label class="text-[10px] font-semibold text-(--p-muted)" for="cot-titulo">Título de la propuesta</label>
          <input class="w-full rounded border border-(--p-line) bg-white px-3 py-[11px] text-[12px] text-(--p-ink) focus:border-[var(--p-accent)] focus:outline-0" id="cot-titulo" name="titulo" maxlength="120" required value="${esc(c?.titulo ?? 'Propuesta comercial')}" />
        </div>

        <div class="mb-4 flex min-w-0 flex-col gap-1.5">
          <label class="text-[10px] font-semibold text-(--p-muted)" for="cot-valor">Valor de la propuesta</label>
          <div class="flex items-center gap-2.5 rounded border border-(--p-line) bg-white px-3 focus-within:border-(--p-accent)">
            <b class="text-[12px] text-(--p-accent)">$</b>
            <input class="min-w-0 flex-1 bg-transparent py-3 text-[13px] font-semibold text-(--p-ink) outline-0" id="cot-valor" name="valor" type="number" min="1" step="any" inputmode="decimal" required placeholder="24500000" value="${esc(valor)}" />
            <em class="text-[10px] not-italic text-(--p-muted)">COP</em>
          </div>
        </div>

        <div class="mb-4 grid grid-cols-1 gap-3 md:grid-cols-2">
          <div class="mb-4 flex min-w-0 flex-col gap-1.5">
            <label class="text-[10px] font-semibold text-(--p-muted)" for="cot-iva">IVA</label>
            <select class="w-full rounded border border-(--p-line) bg-white px-3 py-[11px] text-[12px] text-(--p-ink) focus:border-[var(--p-accent)] focus:outline-0" id="cot-iva" name="iva">
              <option value="1" ${iva === '1' ? 'selected' : ''}>Incluido</option>
              <option value="0" ${iva === '0' ? 'selected' : ''}>No incluido</option>
            </select>
          </div>
          <div class="mb-4 flex min-w-0 flex-col gap-1.5">
            <label class="text-[10px] font-semibold text-(--p-muted)" for="cot-vig">Vigencia (días)</label>
            <input class="w-full rounded border border-(--p-line) bg-white px-3 py-[11px] text-[12px] text-(--p-ink) focus:border-[var(--p-accent)] focus:outline-0" id="cot-vig" name="vigencia" type="number" min="1" max="365" step="1" required value="${esc(c?.vigencia ?? 30)}" />
          </div>
        </div>

        <div class="mb-4 flex min-w-0 flex-col gap-1.5">
          <label class="text-[10px] font-semibold text-(--p-muted)" for="cot-msg">Mensaje para el cliente</label>
          <textarea class="w-full resize-y rounded border border-(--p-line) bg-white px-3 py-[11px] text-[12px] leading-[1.6] text-(--p-ink) focus:border-[var(--p-accent)] focus:outline-0" id="cot-msg" name="mensaje" rows="5" maxlength="2000"
            placeholder="Hemos revisado la información de tu proyecto. Adjuntamos nuestra propuesta con el alcance y las etapas sugeridas.">${esc(c?.descripcion ?? '')}</textarea>
        </div>

        <label class="relative mb-4 flex cursor-pointer items-center justify-center gap-2.5 overflow-hidden break-words rounded-[3px] border border-dashed border-[#cfc8b8] p-3.5 text-center text-[11px] font-semibold text-(--p-muted) hover:bg-[#f8f5ee] focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-[var(--p-accent)]">
          <input class="absolute inset-0 h-full w-full cursor-pointer opacity-0" type="file" name="pdf" accept="application/pdf,.pdf" />
          ${ico('clip')}
          <span id="cot-pdf-txt">${pdfPrevio ? `${esc(pdfPrevio.nombre)} (adjunto)` : 'Adjuntar propuesta en PDF'}</span>
        </label>

        <p class="mb-4.5 text-[12px] text-(--p-accent)" id="adm-form-error" role="alert" hidden></p>
        <button type="submit" class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-[3px] border border-transparent bg-(--p-accent) p-4 text-[13px] font-bold text-white shadow-[0_6px_14px_rgb(192_48_31/.25)] disabled:cursor-not-allowed disabled:opacity-55 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" id="cot-enviar">${ico('send')}<span>Enviar cotización</span></button>
      </form>`;
  }

  // Zona inferior del detalle según el estado de la solicitud.
  function seccionCotizacion(v: Solicitud, d: SolicitudDetalle | null, estado: EstadoDetalle): string {
    const envuelve = (html: string): string => `<div class="border-t border-(--p-line) p-5">${html}</div>`;
    if (estado === 'cargando') return envuelve(`<h3 class="mb-3.5 text-[10px] font-bold uppercase tracking-[.1em] text-(--p-accent)">Cotización</h3><p class="mb-4.5 text-[12px] text-(--p-muted)">Cargando cotización…</p>`);
    if (estado === 'error') return envuelve(`<h3 class="mb-3.5 text-[10px] font-bold uppercase tracking-[.1em] text-(--p-accent)">Cotización</h3><p class="mb-4.5 text-[12px] text-(--p-accent)">No pudimos cargar la cotización.</p>`);

    const c = d?.cotizacion ?? null;

    if (v.estado === 'enviada') {
      return envuelve(`
        <h3 class="mb-4.5 flex items-center gap-2.5 text-[13px] font-bold uppercase tracking-[.02em] text-(--p-muted)"><span class="text-[10px] text-(--p-accent)">02</span> Preparar cotización</h3>
        <div class="flex items-center gap-2.5 border border-dashed border-[#cfc8b8] bg-[#f8f5ee] p-3.5 text-[12px] leading-[1.5] text-(--p-muted)">${ico('lock')}<span>Toma la solicitud para habilitar este apartado y preparar la cotización.</span></div>`);
    }
    if (v.estado === 'evaluacion' && !c) return envuelve(htmlPreparar(v, d));

    return envuelve(`
      <h3 class="mb-3.5 text-[10px] font-bold uppercase tracking-[.1em] text-(--p-accent)">${c ? 'Cotización enviada' : 'Cotización'}</h3>
      ${c ? htmlQuote(c, d) : `<p class="mb-4.5 text-[12px] text-(--p-muted)">Aún no hay una cotización para esta solicitud.</p>`}`);
  }

  // Acciones de gestión según el estado de la solicitud.
  function accionesHtml(v: Solicitud): string {
    if (v.estado !== 'enviada') return '';
    return `
      <div class="flex flex-wrap items-center justify-between gap-3.5 border-b border-[#efe2b8] bg-[#fdf8e8] px-5 py-4">
        <span class="flex min-w-0 flex-col gap-[3px]">
          <strong class="break-words text-[12px] font-semibold">Solicitud nueva</strong>
          <small class="text-[11px] text-[#8a6a1f]">Al tomarla pasa a “En evaluación” y quedas como responsable. El cliente verá el cambio.</small>
        </span>
        <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border border-transparent bg-(--p-accent) px-4.5 py-[11px] text-[12px] font-bold text-white shadow-[0_6px_14px_rgb(192_48_31/.25)] disabled:cursor-not-allowed disabled:opacity-55 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-tomar="${esc(v.id)}">Tomar solicitud</button>
        <button type="button" class="inline-flex cursor-pointer items-center gap-2 rounded-[3px] border border-transparent bg-gray-500 px-4.5 py-[11px] text-[12px] font-bold text-white shadow-[0_6px_14px_rgb(192_48_31/.25)] disabled:cursor-not-allowed disabled:opacity-55 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-rechazar="${esc(v.id)}">Rechazar solicitud</button>
      </div>
      <p class="m-0 border-b border-(--p-line) px-5 py-2.5 text-[12px] text-(--p-accent)" id="adm-error" role="alert" hidden></p>`;
  }

  function pintarDetalle(s: Solicitud | null, d: SolicitudDetalle | null = null, estado: EstadoDetalle = 'ok') {
    if (!s) {
      detalleEl.innerHTML = `<p class="m-0 px-5 py-7 text-[12px] text-(--p-muted)">Selecciona una solicitud para ver su detalle.</p>`;
      return;
    }
    const v = unir(s, d);

    detalleEl.innerHTML = `
      <header class="flex items-start justify-between gap-4 border-b border-(--p-line) p-5">
        <div>
          <p class="mb-1 text-2.25 font-bold uppercase tracking-[.14em] text-(--p-accent)">Detalle de solicitud</p>
          <h2 class="m-0 text-4.5 font-semibold">${esc(v.codigo)}</h2>
        </div>
        <button type="button" class="grid h-[34px] w-[34px] cursor-pointer place-items-center rounded border border-(--p-line) bg-white hover:bg-[#f3efe6] focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-(--p-accent)" data-cerrar aria-label="Cerrar detalle">${ico('x')}</button>
      </header>

      <div class="flex items-center gap-3 border-b border-(--p-line) bg-[#f3efe6] px-5 py-4.5 max-md:flex-wrap">
        <span class="grid h-11 w-11 flex-none place-items-center rounded-full bg-[#ece8df] text-[12px] font-bold text-(--p-ink)">${esc(inicialesDe(v))}</span>
        <span class="flex min-w-0 flex-col gap-[3px]">
          <strong class="break-words text-[12px] font-semibold">${esc(nombreDe(v))}</strong>
          ${v.clienteEmail ? `<a class="inline-flex items-center gap-1.5 break-words text-[11px] text-(--p-muted) no-underline hover:text-(--p-accent)" href="mailto:${esc(v.clienteEmail)}">${ico('mail')}${esc(v.clienteEmail)}</a>` : ''}
        </span>
        ${pill(v, true)}
      </div>

      ${accionesHtml(v)}

      <div class="p-5">
        <h3 class="mb-3.5 text-[10px] font-bold uppercase tracking-[.1em] text-(--p-accent)">Proyecto</h3>
        <p class="mb-4 text-[16px] font-semibold leading-[1.3]">${esc(v.titulo)}</p>
        <dl class="mb-4.5 grid grid-cols-1 gap-x-5 gap-y-3.5 md:grid-cols-2">
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Servicio</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.servicio)}</dd></div>
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Tipo de proyecto</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.tipoProyecto)}</dd></div>
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Ubicación</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.ubicacion)}</dd></div>
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Área</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.area)}</dd></div>
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Presupuesto</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.presupuesto)}</dd></div>
          <div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Plazo de inicio</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.plazoInicio)}</dd></div>
          ${v.fecha ? `<div><dt class="mb-[3px] text-[10px] text-(--p-muted)">Enviada el</dt><dd class="m-0 break-words text-[12px] font-semibold">${esc(v.fecha)}</dd></div>` : ''}
        </dl>
        <p class="m-0 whitespace-pre-line text-[12px] leading-[1.7]">${esc(v.descripcion)}</p>

        <h3 class="mb-3.5 mt-[26px] border-t border-(--p-line) pt-[22px] text-[10px] font-bold uppercase tracking-[.1em] text-(--p-accent)">Archivos del cliente</h3>
        ${htmlArchivos(d, estado)}
      </div>

      ${seccionCotizacion(v, d, estado)}`;
  }

  async function seleccionar(id: string | number) {
    const s = todas.find((x) => String(x.id) === String(id));
    if (!s) return;
    activa = s;
    pintarLista();

    if (cache.has(s.id)) return pintarDetalle(s, cache.get(s.id), 'ok');

    pintarDetalle(s, null, 'cargando');
    try {
      const d: SolicitudDetalle = await detalleSolicitudAdmin(s.id);
      cache.set(s.id, d);
      if (activa?.id === s.id) pintarDetalle(s, d, 'ok');
    } catch {
      if (activa?.id === s.id) pintarDetalle(s, null, 'error');
    }
  }

  // ── Carga inicial ──────────────────────────────────────────────────────
  async function cargar() {
    try {
      todas = await listarSolicitudesAdmin();
    } catch (err) {
      mensaje(mensajeError(err, 'No pudimos cargar las solicitudes. Recarga la página.'));
      return;
    }
    msg.hidden = true;
    cuerpo.hidden = false;
    pintarBadge();
    pintarLista();

    if (todas.length) seleccionar(todas[0].id);
    else pintarDetalle(null);
  }

  // ── Eventos ────────────────────────────────────────────────────────────
  tabsEl.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const b = e.target.closest<HTMLButtonElement>('[data-filtro]');
    if (!b) return;
    filtro = b.dataset.filtro ?? 'todas';
    pagina = 1;
    tabsEl.querySelectorAll('[data-filtro]').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
    pintarLista();
  });

  buscarEl.addEventListener('input', () => {
    texto = buscarEl.value;
    pagina = 1;
    pintarLista();
  });

  pagerEl.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const b = e.target.closest<HTMLButtonElement>('[data-pag]');
    if (!b || b.disabled) return;
    pagina = Number(b.dataset.pag);
    pintarLista();
  });

  listaEl.addEventListener('click', (e) => {
    if (!(e.target instanceof Element)) return;
    const b = e.target.closest<HTMLButtonElement>('[data-id]');
    if (!b?.dataset.id) return;
    seleccionar(b.dataset.id);
    if (window.matchMedia('(max-width: 1279px)').matches) {
      detalleEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  async function refrescar(id: string | number) {
    cache.clear();
    todas = await listarSolicitudesAdmin();
    pintarBadge();
    await seleccionar(id);
  }

  detalleEl.addEventListener('click', async (e) => {
    if (!(e.target instanceof Element)) return;
    if (e.target.closest('[data-cerrar]')) {
      activa = null;
      pintarLista();
      pintarDetalle(null);
      return;
    }

    const dl = e.target.closest<HTMLButtonElement>('[data-descargar]');
    if (dl) {
      if (dl.disabled) return;
      const archivo = activa ? cache.get(activa.id)?.archivos.find((a) => String(a.id) === dl.dataset.descargar) : undefined;
      if (!archivo) return;
      const nota = dl.querySelector<HTMLElement>('small');
      if (!nota) return;
      const original = nota.textContent;
      dl.disabled = true;
      nota.textContent = 'Descargando…';
      try {
        await descargarArchivo(archivo);
        nota.textContent = original;
      } catch (err) {
        nota.textContent = mensajeError(err, 'No pudimos descargar el archivo.');
        nota.classList.add('text-(--p-accent)');
        setTimeout(() => { nota.textContent = original; nota.classList.remove('text-(--p-accent)'); }, 5000);
      }
      dl.disabled = false;
      return;
    }

    const btn = e.target.closest<HTMLButtonElement>('[data-tomar], [data-rechazar]');
    if (!btn || btn.disabled) return;
    const rechazar = Boolean(btn.dataset.rechazar);
    const id = btn.dataset.tomar ?? btn.dataset.rechazar;
    if (!id) return;
    const confirmacion = rechazar
      ? '¿Rechazar esta solicitud? El cliente verá que fue rechazada.'
      : '¿Tomar esta solicitud? Pasará a “En evaluación” y quedarás como responsable.';
    if (!window.confirm(confirmacion)) return;

    const botonesAccion = detalleEl.querySelectorAll<HTMLButtonElement>('[data-tomar], [data-rechazar]');
    botonesAccion.forEach((boton) => { boton.disabled = true; });

    const caja = $('adm-error');
    if (caja) caja.hidden = true;

    try {
      if (rechazar) await rechazarSolicitud(id);
      else await tomarSolicitud(id);
    } catch (err) {
      botonesAccion.forEach((boton) => { boton.disabled = false; });
      if (caja) {
        caja.hidden = false;
        caja.textContent = mensajeError(err, rechazar
          ? 'No se pudo rechazar la solicitud. Intenta de nuevo.'
          : 'No se pudo tomar la solicitud. Intenta de nuevo.');
      }
      return;
    }

    try {
      await refrescar(id);
    } catch {
      mensaje(`La solicitud se ${rechazar ? 'rechazó' : 'tomó'}, pero no pudimos actualizar la lista. Recarga la página.`);
    }
  });

  detalleEl.addEventListener('change', (e) => {
    if (!(e.target instanceof HTMLInputElement) || e.target.name !== 'pdf') return;
    const txt = document.getElementById('cot-pdf-txt');
    if (txt) txt.textContent = e.target.files?.[0]?.name ?? 'Adjuntar propuesta en PDF';
  });

  const idDe = (r: unknown): string | number => {
    if (typeof r !== 'object' || r === null) throw new Error('El servidor no devolvió el identificador esperado.');
    const respuesta = r as RespuestaId;
    const id = respuesta.id ?? respuesta.archivo?.id ?? respuesta.cotizacion?.id;
    if (typeof id !== 'string' && typeof id !== 'number') throw new Error('El servidor no devolvió el identificador esperado.');
    return id;
  };

  // Enviar cotización: (1) sube el PDF, (2) crea o completa la cotización, (3) la envía.
  // Al enviarla el backend pasa la solicitud de "En evaluación" a "Respondida".
  detalleEl.addEventListener('submit', async (e) => {
    if (!(e.target instanceof Element)) return;
    const form = e.target.closest<HTMLFormElement>('#adm-form');
    if (!form) return;
    e.preventDefault();

    const caja = $<HTMLParagraphElement>('adm-form-error');
    const btn = $<HTMLButtonElement>('cot-enviar');
    const etiqueta = btn.querySelector<HTMLSpanElement>('span');
    if (!etiqueta) throw new Error('No se encontró la etiqueta del botón de envío.');
    const textoBtn = etiqueta.textContent;

    const fallo = (texto: string, campo?: string) => {
      caja.hidden = false;
      caja.textContent = texto;
      if (campo) form.querySelector<HTMLElement>(`[name="${campo}"]`)?.focus();
    };
    caja.hidden = true;

    const tituloInput = $<HTMLInputElement>('cot-titulo');
    const valorInput = $<HTMLInputElement>('cot-valor');
    const vigenciaInput = $<HTMLInputElement>('cot-vig');
    const pdfInput = form.querySelector<HTMLInputElement>('[name="pdf"]');
    const ivaInput = $<HTMLSelectElement>('cot-iva');
    const mensajeInput = $<HTMLTextAreaElement>('cot-msg');
    if (!pdfInput) throw new Error('No se encontró el selector del archivo PDF.');
    const titulo = tituloInput.value.trim();
    const valor = Number(valorInput.value);
    const vigencia = Number(vigenciaInput.value);
    const pdf = pdfInput.files?.[0] ?? null;

    if (!titulo) return fallo('Escribe un título para la propuesta.', 'titulo');
    if (!(valor > 0)) return fallo('Ingresa un valor mayor que cero.', 'valor');
    if (valor > 999999999999) return fallo('El valor es demasiado alto.', 'valor');
    if (!Number.isInteger(vigencia) || vigencia < 1 || vigencia > 365) {
      return fallo('La vigencia debe ser un número entero de días entre 1 y 365.', 'vigencia');
    }
    if (pdf && pdf.type !== 'application/pdf' && !/\.pdf$/i.test(pdf.name)) {
      return fallo('La propuesta adjunta debe ser un archivo PDF.', 'pdf');
    }

    const solicitudId = form.dataset.solicitud;
    if (!solicitudId) throw new Error('No se encontró el identificador de la solicitud.');
    const s = todas.find((x) => String(x.id) === String(solicitudId));
    if (!window.confirm(`¿Enviar la cotización por ${fmtMoneda(valor)} a ${s ? nombreDe(s) : 'el cliente'}? La solicitud pasará a “Respondida”.`)) return;

    const bloquear = (si: boolean) =>
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | HTMLButtonElement>('input, select, textarea, button')
        .forEach((c) => { c.disabled = si; });
    bloquear(true);

    const sid = String(solicitudId);
    const previo = intentos.get(sid) ?? { id: form.dataset.cotizacion || null, archivoId: form.dataset.archivo || null };
    let cotizacionId = previo.id;
    let archivoId = previo.archivoId;
    try {
      if (pdf) {
        etiqueta.textContent = 'Subiendo PDF…';
        archivoId = idDe(await subirPropuestaPdf(solicitudId, pdf));
      }

      // El backend reescribe todos los campos al editar: archivo_id debe viajar siempre.
      const datos = {
        titulo,
        valor,
        moneda: 'COP',
        iva_incluido: ivaInput.value === '1',
        vigencia_dias: vigencia,
        mensaje: mensajeInput.value.trim() || null,
        archivo_id: archivoId ? Number(archivoId) : null,
      };

      etiqueta.textContent = 'Guardando…';
      if (cotizacionId) {
        await actualizarCotizacion(cotizacionId, datos);
      } else {
        cotizacionId = idDe(await crearCotizacion(solicitudId, datos));
      }
      intentos.set(sid, { id: cotizacionId, archivoId }); // por si falla el envío y se reintenta

      etiqueta.textContent = 'Enviando…';
      await enviarCotizacion(cotizacionId);
    } catch (err) {
      bloquear(false);
      etiqueta.textContent = textoBtn ?? 'Enviar cotización';
      fallo(mensajeError(err, 'No pudimos enviar la cotización. Intenta de nuevo.'));
      return;
    }

    intentos.delete(String(solicitudId));
    try {
      await refrescar(solicitudId);
    } catch {
      mensaje('La cotización se envió, pero no pudimos actualizar la lista. Recarga la página.');
    }
  });

  // ── Sesión: pedir datos solo cuando hay usuario autenticado ────────────
  function alCambiarSesion(sesion: { status: string }) {
    if (sesion.status !== 'authenticated' || cargado) return;
    cargado = true;
    cargar();
  }
  alCambiarSesion(getSesion());
  suscribirSesion(alCambiarSesion);
</script>
