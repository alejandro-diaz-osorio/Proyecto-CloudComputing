---
import { Search, X, Paperclip, ChevronLeft, ChevronRight, Mail, MapPin, FileText } from '@lucide/astro';
---

<section class="adm">
  <div class="a-top">
    <p class="a-eyebrow">Panel de gestión</p>
    <h1>Solicitudes de cotización</h1>
    <p class="a-sub">Evalúa proyectos y responde a tus clientes desde un solo lugar.</p>
  </div>

  <p class="a-msg" id="adm-msg" role="status">Cargando solicitudes…</p>

  <div class="a-cols" id="adm-cuerpo" hidden>
    <div class="a-card">
      <header class="a-toolbar">
        <div class="a-tabs" id="adm-tabs" role="group" aria-label="Filtrar por estado">
          <button type="button" class="a-tab" data-filtro="todas" aria-pressed="true">Todas</button>
          <button type="button" class="a-tab" data-filtro="enviada" aria-pressed="false">
            Nuevas <span class="a-badge" id="adm-badge" hidden>0</span>
          </button>
          <button type="button" class="a-tab" data-filtro="evaluacion" aria-pressed="false">En evaluación</button>
          <button type="button" class="a-tab" data-filtro="respondida" aria-pressed="false">Respondidas</button>
          <button type="button" class="a-tab" data-filtro="confirmada" aria-pressed="false">Confirmadas</button>
        </div>
        <label class="a-search">
          <Search size={16} strokeWidth={1.6} />
          <input type="search" id="adm-buscar" placeholder="Buscar solicitud…" autocomplete="off" aria-label="Buscar solicitud" />
        </label>
      </header>

      <div class="a-head" aria-hidden="true">
        <span>Solicitud / Cliente</span><span>Proyecto</span><span>Fecha</span><span>Estado</span>
      </div>
      <div id="adm-lista"></div>

      <footer class="a-foot">
        <small id="adm-rango">&nbsp;</small>
        <nav class="a-pager" id="adm-pager" aria-label="Paginación"></nav>
      </footer>
    </div>

    <aside class="a-card a-detail" id="adm-detalle" aria-live="polite"></aside>
  </div>

  <!-- Íconos Lucide para el HTML que se pinta desde JS -->
  <template id="ico-pin"><MapPin size={12} strokeWidth={1.8} /></template>
  <template id="ico-mail"><Mail size={12} strokeWidth={1.8} /></template>
  <template id="ico-clip"><Paperclip size={18} strokeWidth={1.6} /></template>
  <template id="ico-file"><FileText size={18} strokeWidth={1.6} /></template>
  <template id="ico-x"><X size={18} strokeWidth={1.6} /></template>
  <template id="ico-prev"><ChevronLeft size={16} strokeWidth={1.8} /></template>
  <template id="ico-next"><ChevronRight size={16} strokeWidth={1.8} /></template>
</section>

<script>
  import { initSession, getSesion, suscribirSesion } from '../auth/session.js';
  import { listarSolicitudesAdmin, detalleSolicitudAdmin, ESTADOS } from './api.js';

  initSession(); // idempotente: este script corre antes que el del layout

  const POR_PAGINA = 8;

  const $ = (id) => document.getElementById(id);
  const esc = (t) =>
    String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const ico = (n) => $(`ico-${n}`)?.innerHTML ?? '';
  const norm = (t) => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  const msg = $('adm-msg');
  const cuerpo = $('adm-cuerpo');
  const listaEl = $('adm-lista');
  const detalleEl = $('adm-detalle');
  const pagerEl = $('adm-pager');
  const rangoEl = $('adm-rango');
  const badgeEl = $('adm-badge');
  const tabsEl = $('adm-tabs');
  const buscarEl = $('adm-buscar');

  let todas = [];
  let activa = null;
  let filtro = 'todas';
  let texto = '';
  let pagina = 1;
  let cargado = false;
  const cache = new Map(); // solicitudId -> detalle

  const CATEGORIAS = { referencia: 'Referencia', plano: 'Plano' };
  const ESTADOS_COT = { borrador: 'Borrador', vigente: 'Vigente', reemplazada: 'Reemplazada', confirmada: 'Confirmada' };

  const nombreDe = (s) => s.cliente ?? `Cliente #${s.clienteId ?? '—'}`;
  const inicialesDe = (s) => {
    if (!s.cliente) return 'CL';
    const p = s.cliente.split(/\s+/).filter(Boolean);
    return ((p[0]?.[0] ?? '') + (p[1]?.[0] ?? '')).toUpperCase() || 'CL';
  };
  const estadoDe = (s) => ESTADOS[s.estado] ?? ESTADOS.enviada;
  const pill = (s, extra = '') => {
    const e = estadoDe(s);
    return `<span class="a-pill a-pill--${e.tono} ${extra}"><i class="a-dot"></i>${e.label}</span>`;
  };

  function mensaje(texto) {
    msg.hidden = false;
    msg.textContent = texto;
  }

  // ── Filtrado y lista ───────────────────────────────────────────────────
  function visibles() {
    const q = norm(texto.trim());
    return todas.filter((s) => {
      if (filtro !== 'todas' && s.estado !== filtro) return false;
      if (!q) return true;
      return norm([s.codigo, s.titulo, nombreDe(s), s.clienteEmail, s.ubicacion].join(' ')).includes(q);
    });
  }

  function pintarBadge() {
    const nuevas = todas.filter((s) => s.estado === 'enviada').length;
    badgeEl.hidden = nuevas === 0;
    badgeEl.textContent = nuevas;
  }

  function filaHtml(s) {
    return `
      <button type="button" class="a-row" data-id="${esc(s.id)}" aria-current="${s.id === activa?.id}">
        <span class="a-who">
          <span class="a-avatar">${esc(inicialesDe(s))}</span>
          <span class="a-stack"><strong>${esc(nombreDe(s))}</strong><small class="a-mono">${esc(s.codigo)}</small></span>
        </span>
        <span class="a-proj a-stack"><strong>${esc(s.titulo)}</strong><small>${esc(s.servicio)}</small></span>
        <span class="a-date">${esc(s.fecha)}</span>
        <span class="a-state">${pill(s)}</span>
      </button>`;
  }

  function pintarPaginador(paginas) {
    if (paginas <= 1) {
      pagerEl.innerHTML = '';
      return;
    }
    const ini = Math.max(1, Math.min(pagina - 2, paginas - 4));
    const fin = Math.min(paginas, ini + 4);
    let html = `<button type="button" class="a-pg" data-pag="${pagina - 1}" aria-label="Página anterior" ${pagina === 1 ? 'disabled' : ''}>${ico('prev')}</button>`;
    for (let p = ini; p <= fin; p++) {
      html += `<button type="button" class="a-pg" data-pag="${p}" ${p === pagina ? 'aria-current="page"' : ''}>${p}</button>`;
    }
    html += `<button type="button" class="a-pg" data-pag="${pagina + 1}" aria-label="Página siguiente" ${pagina === paginas ? 'disabled' : ''}>${ico('next')}</button>`;
    pagerEl.innerHTML = html;
  }

  function pintarLista() {
    const filas = visibles();
    const total = filas.length;
    const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
    pagina = Math.min(pagina, paginas);
    const desde = (pagina - 1) * POR_PAGINA;
    const pag = filas.slice(desde, desde + POR_PAGINA);

    listaEl.innerHTML = pag.length
      ? pag.map(filaHtml).join('')
      : `<p class="a-vacio">${todas.length ? 'Ninguna solicitud coincide con tu búsqueda.' : 'Aún no hay solicitudes enviadas.'}</p>`;

    rangoEl.textContent = total
      ? `Mostrando ${desde + 1}–${desde + pag.length} de ${total} solicitud${total === 1 ? '' : 'es'}`
      : '\u00a0';
    pintarPaginador(paginas);
  }

  // ── Detalle ────────────────────────────────────────────────────────────
  // El detalle viene de otro endpoint: lo que ya conocemos de la lista se conserva si falta allí.
  function unir(s, d) {
    if (!d) return s;
    return {
      ...s,
      ...d,
      cliente: d.cliente ?? s.cliente,
      clienteEmail: d.clienteEmail || s.clienteEmail,
      servicio: d.servicio !== '—' ? d.servicio : s.servicio,
    };
  }

  function htmlArchivos(d, estado) {
    if (estado === 'cargando') return `<p class="a-note">Cargando archivos…</p>`;
    if (estado === 'error') return `<p class="a-note a-note--error">No pudimos cargar los archivos.</p>`;
    // Los archivos de categoría "cotizacion" son de la administración, no del cliente.
    const archivos = (d?.archivos ?? []).filter((a) => a.categoria !== 'cotizacion');
    if (!archivos.length) return `<p class="a-note">El cliente no adjuntó archivos.</p>`;
    return archivos
      .map(
        (a) => `
        <div class="a-file">
          <span class="a-file__ico">${ico('clip')}</span>
          <span class="a-stack"><strong>${esc(a.nombre)}</strong><small>${esc([CATEGORIAS[a.categoria] ?? a.categoria, a.tamano].filter(Boolean).join(' · '))}</small></span>
        </div>`,
      )
      .join('');
  }

  function htmlCotizacion(d, estado) {
    if (estado === 'cargando') return `<p class="a-note">Cargando cotización…</p>`;
    if (estado === 'error') return `<p class="a-note a-note--error">No pudimos cargar la cotización.</p>`;
    const c = d?.cotizacion;
    if (!c) return `<p class="a-note">Aún no hay una cotización para esta solicitud.</p>`;
    const valor = Number.isFinite(c.valor)
      ? new Intl.NumberFormat('es-CO', { style: 'currency', currency: c.moneda, maximumFractionDigits: 0 }).format(c.valor)
      : '—';
    return `
      <div class="a-quote">
        <div class="a-quote__head">
          <span class="a-quote__ico">${ico('file')}</span>
          <span class="a-stack">
            <strong>${esc(c.titulo)}${c.version > 1 ? ` · versión ${esc(c.version)}` : ''}</strong>
            <small>${esc(ESTADOS_COT[c.estado] ?? c.estado)}${c.vigencia ? ` · vigencia de ${esc(c.vigencia)} días` : ''}</small>
          </span>
        </div>
        <div class="a-quote__val"><small>Valor de la propuesta</small><strong>${esc(valor)}</strong></div>
        ${c.descripcion ? `<p class="a-quote__desc">${esc(c.descripcion)}</p>` : ''}
      </div>`;
  }

  function pintarDetalle(s, d = null, estado = 'ok') {
    if (!s) {
      detalleEl.innerHTML = `<p class="a-vacio">Selecciona una solicitud para ver su detalle.</p>`;
      return;
    }
    const v = unir(s, d);

    detalleEl.innerHTML = `
      <header class="a-detail__head">
        <div>
          <p class="a-eyebrow a-eyebrow--sm">Detalle de solicitud</p>
          <h2>${esc(v.codigo)}</h2>
        </div>
        <button type="button" class="a-iconbtn" data-cerrar aria-label="Cerrar detalle">${ico('x')}</button>
      </header>

      <div class="a-client">
        <span class="a-avatar a-avatar--lg">${esc(inicialesDe(v))}</span>
        <span class="a-stack">
          <strong>${esc(nombreDe(v))}</strong>
          ${v.clienteEmail ? `<a class="a-mail" href="mailto:${esc(v.clienteEmail)}">${ico('mail')}${esc(v.clienteEmail)}</a>` : ''}
        </span>
        ${pill(v, 'a-pill--big')}
      </div>

      <div class="a-body">
        <h3 class="a-sect">Proyecto</h3>
        <p class="a-title">${esc(v.titulo)}</p>
        <dl class="a-info">
          <div><dt>Servicio</dt><dd>${esc(v.servicio)}</dd></div>
          <div><dt>Tipo de proyecto</dt><dd>${esc(v.tipoProyecto)}</dd></div>
          <div><dt>Ubicación</dt><dd>${esc(v.ubicacion)}</dd></div>
          <div><dt>Área</dt><dd>${esc(v.area)}</dd></div>
          <div><dt>Presupuesto</dt><dd>${esc(v.presupuesto)}</dd></div>
          <div><dt>Plazo de inicio</dt><dd>${esc(v.plazoInicio)}</dd></div>
          ${v.fecha ? `<div><dt>Enviada el</dt><dd>${esc(v.fecha)}</dd></div>` : ''}
        </dl>
        <p class="a-desc">${esc(v.descripcion)}</p>

        <h3 class="a-sect">Archivos del cliente</h3>
        ${htmlArchivos(d, estado)}

        <h3 class="a-sect">Cotización</h3>
        ${htmlCotizacion(d, estado)}
      </div>`;
  }

  async function seleccionar(id) {
    const s = todas.find((x) => String(x.id) === String(id));
    if (!s) return;
    activa = s;
    pintarLista();

    if (cache.has(s.id)) return pintarDetalle(s, cache.get(s.id), 'ok');

    pintarDetalle(s, null, 'cargando');
    try {
      const d = await detalleSolicitudAdmin(s.id);
      cache.set(s.id, d);
      if (activa?.id === s.id) pintarDetalle(s, d, 'ok');
    } catch {
      if (activa?.id === s.id) pintarDetalle(s, null, 'error');
    }
  }

  // ── Carga inicial ──────────────────────────────────────────────────────
  async function cargar() {
    try {
      todas = await listarSolicitudesAdmin();
    } catch (err) {
      mensaje(err?.message || 'No pudimos cargar las solicitudes. Recarga la página.');
      return;
    }
    msg.hidden = true;
    cuerpo.hidden = false;
    pintarBadge();
    pintarLista();

    if (todas.length) seleccionar(todas[0].id);
    else pintarDetalle(null);
  }

  // ── Eventos ────────────────────────────────────────────────────────────
  tabsEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-filtro]');
    if (!b) return;
    filtro = b.dataset.filtro;
    pagina = 1;
    tabsEl.querySelectorAll('[data-filtro]').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
    pintarLista();
  });

  buscarEl.addEventListener('input', () => {
    texto = buscarEl.value;
    pagina = 1;
    pintarLista();
  });

  pagerEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-pag]');
    if (!b || b.disabled) return;
    pagina = Number(b.dataset.pag);
    pintarLista();
  });

  listaEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-id]');
    if (!b) return;
    seleccionar(b.dataset.id);
    if (window.matchMedia('(max-width: 1279px)').matches) {
      detalleEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  detalleEl.addEventListener('click', (e) => {
    if (!e.target.closest('[data-cerrar]')) return;
    activa = null;
    pintarLista();
    pintarDetalle(null);
  });

  // ── Sesión: pedir datos solo cuando hay usuario autenticado ────────────
  function alCambiarSesion(sesion) {
    if (sesion.status !== 'authenticated' || cargado) return;
    cargado = true;
    cargar();
  }
  alCambiarSesion(getSesion());
  suscribirSesion(alCambiarSesion);
</script>

<!-- Global porque parte del HTML se genera desde JS -->
<style is:global>
  .adm h1 { font-size: clamp(1.9rem, 3vw, 2.6rem); font-weight: 800; text-transform: uppercase; letter-spacing: -.01em; line-height: 1.1; margin: 0; }
  .adm h2 { font-size: 15px; font-weight: 600; margin: 0; }
  .adm small { font-size: 11px; color: var(--p-muted); }
  .adm button { font: inherit; color: inherit; }
  .adm .a-mono { letter-spacing: .08em; }
  .adm .a-stack { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .adm .a-stack strong { font-size: 12px; font-weight: 600; overflow-wrap: anywhere; }

  .adm .a-top { margin-bottom: 28px; }
  .adm .a-eyebrow { font-size: 10px; letter-spacing: .14em; text-transform: uppercase; font-weight: 700; color: var(--p-accent); margin: 0 0 6px; }
  .adm .a-eyebrow--sm { font-size: 9px; margin-bottom: 4px; }
  .adm .a-sub { margin: 6px 0 0; font-size: 13px; color: var(--p-muted); }
  .adm .a-msg { padding: 16px; font-size: 13px; color: var(--p-muted); }
  .adm .a-vacio { padding: 28px 20px; margin: 0; font-size: 12px; color: var(--p-muted); }
  .adm .a-note { margin: 0 0 18px; font-size: 12px; color: var(--p-muted); }
  .adm .a-note--error { color: var(--p-accent); }

  .adm .a-cols { display: grid; grid-template-columns: minmax(0, 1fr) 380px; gap: 18px; align-items: start; }
  .adm .a-card { background: var(--p-card); border: 1px solid var(--p-line); min-width: 0; }

  /* Barra de herramientas */
  .adm .a-toolbar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--p-line); }
  .adm .a-tabs { display: flex; flex-wrap: wrap; gap: 4px; }
  .adm .a-tab { display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px; background: none; border: 0; border-radius: 3px; font-size: 11px; font-weight: 600; color: var(--p-ink); cursor: pointer; }
  .adm .a-tab:hover { background: #f3efe6; }
  .adm .a-tab[aria-pressed='true'] { background: #f9e3df; color: var(--p-accent); }
  .adm .a-badge { display: inline-grid; place-items: center; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 999px; background: var(--p-accent); color: #fff; font-size: 9px; font-weight: 700; }
  .adm .a-search { display: flex; align-items: center; gap: 8px; width: 240px; max-width: 100%; padding: 0 12px; height: 38px; background: #fff; border: 1px solid var(--p-line); border-radius: 4px; color: var(--p-muted); }
  .adm .a-search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: 12px; color: var(--p-ink); }
  .adm .a-search:focus-within { border-color: var(--p-accent); }

  /* Tabla */
  .adm .a-head,
  .adm .a-row { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.3fr) 112px 118px; gap: 16px; align-items: center; padding: 0 20px; }
  .adm .a-head { padding-top: 12px; padding-bottom: 12px; border-bottom: 1px solid var(--p-line); font-size: 9px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--p-muted); }
  .adm .a-row { position: relative; width: 100%; padding-top: 16px; padding-bottom: 16px; text-align: left; background: none; border: 0; border-bottom: 1px solid var(--p-line); cursor: pointer; }
  .adm .a-row:hover { background: #f8f5ee; }
  .adm .a-row[aria-current='true'] { background: #f3efe6; }
  .adm .a-row[aria-current='true']::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--p-accent); }
  .adm .a-who { display: flex; align-items: center; gap: 12px; min-width: 0; }
  .adm .a-date { font-size: 11px; color: var(--p-muted); }
  .adm .a-avatar { display: grid; place-items: center; flex: none; width: 32px; height: 32px; border-radius: 50%; background: #ece8df; color: var(--p-ink); font-size: 10px; font-weight: 700; }
  .adm .a-avatar--lg { width: 44px; height: 44px; font-size: 12px; }

  .adm .a-foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 20px; }
  .adm .a-pager { display: flex; }
  .adm .a-pg { display: grid; place-items: center; min-width: 32px; height: 32px; padding: 0 6px; background: #fff; border: 1px solid var(--p-line); margin-left: -1px; font-size: 11px; cursor: pointer; }
  .adm .a-pg:hover:not(:disabled) { background: #f3efe6; }
  .adm .a-pg[aria-current='page'] { background: var(--p-accent); border-color: var(--p-accent); color: #fff; font-weight: 700; }
  .adm .a-pg:disabled { opacity: .45; cursor: not-allowed; }

  .adm .a-pill { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; font-size: 10px; font-weight: 600; white-space: nowrap; }
  .adm .a-dot { width: 5px; height: 5px; border-radius: 50%; background: currentColor; }
  .adm .a-pill--accent { background: #f9e3df; color: var(--p-accent); }
  .adm .a-pill--warn { background: #f3ead4; color: #8a6a1f; }
  .adm .a-pill--ok { background: #dcebe2; color: #2f6b4a; }
  .adm .a-pill--info { background: #e4ecf5; color: #3f6aa0; }
  .adm .a-pill--big { padding: 5px 12px; margin-left: auto; align-self: flex-start; }

  /* Panel de detalle */
  .adm .a-detail { position: sticky; top: 86px; max-height: calc(100vh - 102px); overflow-y: auto; }
  .adm .a-detail__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; padding: 20px; border-bottom: 1px solid var(--p-line); }
  .adm .a-detail__head h2 { font-size: 18px; }
  .adm .a-iconbtn { display: grid; place-items: center; width: 34px; height: 34px; background: #fff; border: 1px solid var(--p-line); border-radius: 4px; cursor: pointer; }
  .adm .a-iconbtn:hover { background: #f3efe6; }
  .adm .a-client { display: flex; align-items: center; gap: 12px; padding: 18px 20px; background: #f3efe6; border-bottom: 1px solid var(--p-line); }
  .adm .a-mail { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; color: var(--p-muted); text-decoration: none; overflow-wrap: anywhere; }
  .adm .a-mail:hover { color: var(--p-accent); }
  .adm .a-body { padding: 20px; }
  .adm .a-sect { margin: 0 0 14px; font-size: 10px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--p-accent); }
  .adm .a-sect:not(:first-child) { margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--p-line); }
  .adm .a-title { margin: 0 0 16px; font-size: 16px; font-weight: 600; line-height: 1.3; }
  .adm .a-info { display: grid; grid-template-columns: 1fr 1fr; gap: 14px 20px; margin: 0 0 18px; }
  .adm .a-info dt { font-size: 10px; color: var(--p-muted); margin-bottom: 3px; }
  .adm .a-info dd { margin: 0; font-size: 12px; font-weight: 600; overflow-wrap: anywhere; }
  .adm .a-desc { margin: 0; font-size: 12px; line-height: 1.7; white-space: pre-line; }

