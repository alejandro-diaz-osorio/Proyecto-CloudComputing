---
import { Search, X, Paperclip, ChevronLeft, ChevronRight, Mail, MapPin, FileText, Send, Lock, Download } from '@lucide/astro';
---

<section class="adm">
  <div class="a-top">
    <p class="a-eyebrow">Panel de gestión</p>
    <h1>Solicitudes de cotización</h1>
    <p class="a-sub">Evalúa proyectos y responde a tus clientes desde un solo lugar.</p>
  </div>

  <p class="a-msg" id="adm-msg" role="status">Cargando solicitudes…</p>

  <div class="a-cols" id="adm-cuerpo" hidden>
    <div class="a-card">
      <header class="a-toolbar">
        <div class="a-tabs" id="adm-tabs" role="group" aria-label="Filtrar por estado">
          <button type="button" class="a-tab" data-filtro="todas" aria-pressed="true">Todas</button>
          <button type="button" class="a-tab" data-filtro="enviada" aria-pressed="false">
            Nuevas <span class="a-badge" id="adm-badge" hidden>0</span>
          </button>
          <button type="button" class="a-tab" data-filtro="evaluacion" aria-pressed="false">En evaluación</button>
          <button type="button" class="a-tab" data-filtro="respondida" aria-pressed="false">Respondidas</button>
          <button type="button" class="a-tab" data-filtro="confirmada" aria-pressed="false">Confirmadas</button>
        </div>
        <label class="a-search">
          <Search size={16} strokeWidth={1.6} />
          <input type="search" id="adm-buscar" placeholder="Buscar solicitud…" autocomplete="off" aria-label="Buscar solicitud" />
        </label>
      </header>

      <div class="a-head" aria-hidden="true">
        <span>Solicitud / Cliente</span><span>Proyecto</span><span>Fecha</span><span>Estado</span>
      </div>
      <div id="adm-lista"></div>

      <footer class="a-foot">
        <small id="adm-rango">&nbsp;</small>
        <nav class="a-pager" id="adm-pager" aria-label="Paginación"></nav>
      </footer>
    </div>

    <aside class="a-card a-detail" id="adm-detalle" aria-live="polite"></aside>
  </div>

  <!-- Íconos Lucide para el HTML que se pinta desde JS -->
  <template id="ico-pin"><MapPin size={12} strokeWidth={1.8} /></template>
  <template id="ico-mail"><Mail size={12} strokeWidth={1.8} /></template>
  <template id="ico-clip"><Paperclip size={18} strokeWidth={1.6} /></template>
  <template id="ico-file"><FileText size={18} strokeWidth={1.6} /></template>
  <template id="ico-down"><Download size={18} strokeWidth={1.6} /></template>
  <template id="ico-send"><Send size={16} strokeWidth={1.8} /></template>
  <template id="ico-lock"><Lock size={16} strokeWidth={1.6} /></template>
  <template id="ico-x"><X size={18} strokeWidth={1.6} /></template>
  <template id="ico-prev"><ChevronLeft size={16} strokeWidth={1.8} /></template>
  <template id="ico-next"><ChevronRight size={16} strokeWidth={1.8} /></template>
</section>

<script>
  import { initSession, getSesion, suscribirSesion } from '../auth/session.js';
  import {
    listarSolicitudesAdmin,
    detalleSolicitudAdmin,
    tomarSolicitud,
    subirPropuestaPdf,
    descargarArchivo,
    crearCotizacion,
    actualizarCotizacion,
    enviarCotizacion,
    ESTADOS,
  } from './api.js';

  initSession(); // idempotente: este script corre antes que el del layout

  const POR_PAGINA = 8;

  const $ = (id) => document.getElementById(id);
  const esc = (t) =>
    String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const ico = (n) => $(`ico-${n}`)?.innerHTML ?? '';
  const norm = (t) => String(t ?? '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

  const msg = $('adm-msg');
  const cuerpo = $('adm-cuerpo');
  const listaEl = $('adm-lista');
  const detalleEl = $('adm-detalle');
  const pagerEl = $('adm-pager');
  const rangoEl = $('adm-rango');
  const badgeEl = $('adm-badge');
  const tabsEl = $('adm-tabs');
  const buscarEl = $('adm-buscar');

  let todas = [];
  let activa = null;
  let filtro = 'todas';
  let texto = '';
  let pagina = 1;
  let cargado = false;
  const cache = new Map(); // solicitudId -> detalle

  const CATEGORIAS = { referencia: 'Referencia', plano: 'Plano' };
  const ESTADOS_COT = { borrador: 'Borrador', vigente: 'Vigente', reemplazada: 'Reemplazada', confirmada: 'Confirmada' };

  const fmtMoneda = (n, moneda = 'COP') =>
    new Intl.NumberFormat('es-CO', { style: 'currency', currency: moneda, maximumFractionDigits: 0 }).format(n);
  // Cotizaciones creadas en un intento de envío que falló a medias: se reutilizan al reintentar.
  const intentos = new Map(); // solicitudId -> { id: cotizacionId, archivoId }

  const nombreDe = (s) => s.cliente ?? `Cliente #${s.clienteId ?? '—'}`;
  const inicialesDe = (s) => {
    if (!s.cliente) return 'CL';
    const p = s.cliente.split(/\s+/).filter(Boolean);
    return ((p[0]?.[0] ?? '') + (p[1]?.[0] ?? '')).toUpperCase() || 'CL';
  };
  const estadoDe = (s) => ESTADOS[s.estado] ?? ESTADOS.enviada;
  const pill = (s, extra = '') => {
    const e = estadoDe(s);
    return `<span class="a-pill a-pill--${e.tono} ${extra}"><i class="a-dot"></i>${e.label}</span>`;
  };

  function mensaje(texto) {
    msg.hidden = false;
    msg.textContent = texto;
  }

  // ── Filtrado y lista ───────────────────────────────────────────────────
  function visibles() {
    const q = norm(texto.trim());
    return todas.filter((s) => {
      if (filtro !== 'todas' && s.estado !== filtro) return false;
      if (!q) return true;
      return norm([s.codigo, s.titulo, nombreDe(s), s.clienteEmail, s.ubicacion].join(' ')).includes(q);
    });
  }

  function pintarBadge() {
    const nuevas = todas.filter((s) => s.estado === 'enviada').length;
    badgeEl.hidden = nuevas === 0;
    badgeEl.textContent = nuevas;
  }

  function filaHtml(s) {
    return `
      <button type="button" class="a-row" data-id="${esc(s.id)}" aria-current="${s.id === activa?.id}">
        <span class="a-who">
          <span class="a-avatar">${esc(inicialesDe(s))}</span>
          <span class="a-stack"><strong>${esc(nombreDe(s))}</strong><small class="a-mono">${esc(s.codigo)}</small></span>
        </span>
        <span class="a-proj a-stack"><strong>${esc(s.titulo)}</strong><small>${esc(s.servicio)}</small></span>
        <span class="a-date">${esc(s.fecha)}</span>
        <span class="a-state">${pill(s)}</span>
      </button>`;
  }

  function pintarPaginador(paginas) {
    if (paginas <= 1) {
      pagerEl.innerHTML = '';
      return;
    }
    const ini = Math.max(1, Math.min(pagina - 2, paginas - 4));
    const fin = Math.min(paginas, ini + 4);
    let html = `<button type="button" class="a-pg" data-pag="${pagina - 1}" aria-label="Página anterior" ${pagina === 1 ? 'disabled' : ''}>${ico('prev')}</button>`;
    for (let p = ini; p <= fin; p++) {
      html += `<button type="button" class="a-pg" data-pag="${p}" ${p === pagina ? 'aria-current="page"' : ''}>${p}</button>`;
    }
    html += `<button type="button" class="a-pg" data-pag="${pagina + 1}" aria-label="Página siguiente" ${pagina === paginas ? 'disabled' : ''}>${ico('next')}</button>`;
    pagerEl.innerHTML = html;
  }

  function pintarLista() {
    const filas = visibles();
    const total = filas.length;
    const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
    pagina = Math.min(pagina, paginas);
    const desde = (pagina - 1) * POR_PAGINA;
    const pag = filas.slice(desde, desde + POR_PAGINA);

    listaEl.innerHTML = pag.length
      ? pag.map(filaHtml).join('')
      : `<p class="a-vacio">${todas.length ? 'Ninguna solicitud coincide con tu búsqueda.' : 'Aún no hay solicitudes enviadas.'}</p>`;

    rangoEl.textContent = total
      ? `Mostrando ${desde + 1}–${desde + pag.length} de ${total} solicitud${total === 1 ? '' : 'es'}`
      : '\u00a0';
    pintarPaginador(paginas);
  }

  // ── Detalle ────────────────────────────────────────────────────────────
  // El detalle viene de otro endpoint: lo que ya conocemos de la lista se conserva si falta allí.
  function unir(s, d) {
    if (!d) return s;
    return {
      ...s,
      ...d,
      cliente: d.cliente ?? s.cliente,
      clienteEmail: d.clienteEmail || s.clienteEmail,
      servicio: d.servicio !== '—' ? d.servicio : s.servicio,
    };
  }

  // Fila de archivo con descarga (la ruta exige sesión, por eso es un botón y no un enlace).
  function htmlArchivo(a, detalle, extra = '') {
    return `
      <button type="button" class="a-file ${extra}" data-descargar="${esc(a.id)}" aria-label="Descargar ${esc(a.nombre)}">
        <span class="a-file__ico">${ico('clip')}</span>
        <span class="a-stack"><strong>${esc(a.nombre)}</strong><small>${esc(detalle.filter(Boolean).join(' · '))}</small></span>
        <span class="a-file__dl">${ico('down')}</span>
      </button>`;
  }

  function htmlArchivos(d, estado) {
    if (estado === 'cargando') return `<p class="a-note">Cargando archivos…</p>`;
    if (estado === 'error') return `<p class="a-note a-note--error">No pudimos cargar los archivos.</p>`;
    // Los archivos de categoría "cotizacion" son de la administración, no del cliente.
    const archivos = (d?.archivos ?? []).filter((a) => a.categoria !== 'cotizacion');
    if (!archivos.length) return `<p class="a-note">El cliente no adjuntó archivos.</p>`;
    return archivos.map((a) => htmlArchivo(a, [CATEGORIAS[a.categoria] ?? a.categoria, a.tamano])).join('');
  }

  function htmlQuote(c, d) {
    const valor = Number.isFinite(c.valor) ? fmtMoneda(c.valor, c.moneda) : '—';
    const pdf = c.archivoId ? (d?.archivos ?? []).find((a) => String(a.id) === String(c.archivoId)) : null;
    const meta = [c.enviada && ['Enviada el', c.enviada], c.vence && ['Válida hasta', c.vence]].filter(Boolean);
    return `
      <div class="a-quote">
        <div class="a-quote__head">
          <span class="a-quote__ico">${ico('file')}</span>
          <span class="a-stack">
            <strong>${esc(c.titulo)}${c.version > 1 ? ` · versión ${esc(c.version)}` : ''}</strong>
            <small>${esc([
              ESTADOS_COT[c.estado] ?? c.estado,
              c.vigencia ? `Vigencia de ${c.vigencia} días` : '',
              c.ivaIncluido === true ? 'IVA incluido' : c.ivaIncluido === false ? 'Más IVA' : '',
            ].filter(Boolean).join(' · '))}</small>
          </span>
        </div>
        <div class="a-quote__val"><small>Valor de la propuesta</small><strong>${esc(valor)}</strong></div>
        ${meta.length ? `<dl class="a-info a-quote__meta">${meta.map(([k, t]) => `<div><dt>${k}</dt><dd>${esc(t)}</dd></div>`).join('')}</dl>` : ''}
        ${c.descripcion ? `<p class="a-quote__desc">${esc(c.descripcion)}</p>` : ''}
      </div>
      ${pdf ? htmlArchivo(pdf, ['Propuesta en PDF', pdf.tamano], 'a-file--quote') : ''}`;
  }

  // Formulario "Preparar cotización": solo con la solicitud En evaluación y sin cotización enviada.
  function htmlPreparar(v, d) {
    const c = d?.borrador ?? null;
    const valor = c && Number.isFinite(c.valor) ? c.valor : '';
    const pdfPrevio = c?.archivoId ? (d.archivos ?? []).find((a) => String(a.id) === String(c.archivoId)) : null;
    const iva = c?.ivaIncluido === false ? '0' : '1';
    return `
      <form class="a-prep" id="adm-form" novalidate data-solicitud="${esc(v.id)}" data-cotizacion="${esc(c?.id ?? '')}" data-archivo="${esc(c?.archivoId ?? '')}">
        <h3 class="a-prep__title"><span>02</span> Preparar cotización</h3>
        ${c ? `<p class="a-note">Hay un borrador guardado: puedes completarlo y enviarlo.</p>` : ''}

        <div class="a-field">
          <label for="cot-titulo">Título de la propuesta</label>
          <input class="a-input" id="cot-titulo" name="titulo" maxlength="120" required value="${esc(c?.titulo ?? 'Propuesta comercial')}" />
        </div>

        <div class="a-field">
          <label for="cot-valor">Valor de la propuesta</label>
          <div class="a-money">
            <b>$</b>
            <input id="cot-valor" name="valor" type="number" min="1" step="any" inputmode="decimal" required placeholder="24500000" value="${esc(valor)}" />
            <em>COP</em>
          </div>
        </div>

        <div class="a-two">
          <div class="a-field">
            <label for="cot-iva">IVA</label>
            <select class="a-input" id="cot-iva" name="iva">
              <option value="1" ${iva === '1' ? 'selected' : ''}>Incluido</option>
              <option value="0" ${iva === '0' ? 'selected' : ''}>No incluido</option>
            </select>
          </div>
          <div class="a-field">
            <label for="cot-vig">Vigencia (días)</label>
            <input class="a-input" id="cot-vig" name="vigencia" type="number" min="1" max="365" step="1" required value="${esc(c?.vigencia ?? 30)}" />
          </div>
        </div>

        <div class="a-field">
          <label for="cot-msg">Mensaje para el cliente</label>
          <textarea class="a-input" id="cot-msg" name="mensaje" rows="5" maxlength="2000"
            placeholder="Hemos revisado la información de tu proyecto. Adjuntamos nuestra propuesta con el alcance y las etapas sugeridas.">${esc(c?.descripcion ?? '')}</textarea>
        </div>

        <label class="a-drop">
          <input type="file" name="pdf" accept="application/pdf,.pdf" />
          ${ico('clip')}
          <span id="cot-pdf-txt">${pdfPrevio ? `${esc(pdfPrevio.nombre)} (adjunto)` : 'Adjuntar propuesta en PDF'}</span>
        </label>

        <p class="a-note a-note--error" id="adm-form-error" role="alert" hidden></p>
        <button type="submit" class="a-btn a-btn--primary a-btn--block" id="cot-enviar">${ico('send')}<span>Enviar cotización</span></button>
      </form>`;
  }

  // Zona inferior del detalle según el estado de la solicitud.
  function seccionCotizacion(v, d, estado) {
    const envuelve = (html) => `<div class="a-body a-body--cot">${html}</div>`;
    if (estado === 'cargando') return envuelve(`<h3 class="a-sect">Cotización</h3><p class="a-note">Cargando cotización…</p>`);
    if (estado === 'error') return envuelve(`<h3 class="a-sect">Cotización</h3><p class="a-note a-note--error">No pudimos cargar la cotización.</p>`);

    const c = d?.cotizacion ?? null;

    if (v.estado === 'enviada') {
      return envuelve(`
        <h3 class="a-prep__title a-prep__title--off"><span>02</span> Preparar cotización</h3>
        <div class="a-lock">${ico('lock')}<span>Toma la solicitud para habilitar este apartado y preparar la cotización.</span></div>`);
    }
    if (v.estado === 'evaluacion' && !c) return envuelve(htmlPreparar(v, d));

    return envuelve(`
      <h3 class="a-sect">${c ? 'Cotización enviada' : 'Cotización'}</h3>
      ${c ? htmlQuote(c, d) : `<p class="a-note">Aún no hay una cotización para esta solicitud.</p>`}`);
  }

  // Acciones de gestión según el estado de la solicitud.
  function accionesHtml(v) {
    if (v.estado !== 'enviada') return '';
    return `
      <div class="a-action">
        <span class="a-stack">
          <strong>Solicitud nueva</strong>
          <small>Al tomarla pasa a “En evaluación” y quedas como responsable. El cliente verá el cambio.</small>
        </span>
        <button type="button" class="a-btn a-btn--primary" data-tomar="${esc(v.id)}">Tomar solicitud</button>
      </div>
      <p class="a-note a-note--error a-note--pad" id="adm-error" role="alert" hidden></p>`;
  }

  function pintarDetalle(s, d = null, estado = 'ok') {
    if (!s) {
      detalleEl.innerHTML = `<p class="a-vacio">Selecciona una solicitud para ver su detalle.</p>`;
      return;
    }
    const v = unir(s, d);

    detalleEl.innerHTML = `
      <header class="a-detail__head">
        <div>
          <p class="a-eyebrow a-eyebrow--sm">Detalle de solicitud</p>
          <h2>${esc(v.codigo)}</h2>
        </div>
        <button type="button" class="a-iconbtn" data-cerrar aria-label="Cerrar detalle">${ico('x')}</button>
      </header>

      <div class="a-client">
        <span class="a-avatar a-avatar--lg">${esc(inicialesDe(v))}</span>
        <span class="a-stack">
          <strong>${esc(nombreDe(v))}</strong>
          ${v.clienteEmail ? `<a class="a-mail" href="mailto:${esc(v.clienteEmail)}">${ico('mail')}${esc(v.clienteEmail)}</a>` : ''}
        </span>
        ${pill(v, 'a-pill--big')}
      </div>

      ${accionesHtml(v)}

      <div class="a-body">
        <h3 class="a-sect">Proyecto</h3>
        <p class="a-title">${esc(v.titulo)}</p>
        <dl class="a-info">
          <div><dt>Servicio</dt><dd>${esc(v.servicio)}</dd></div>
          <div><dt>Tipo de proyecto</dt><dd>${esc(v.tipoProyecto)}</dd></div>
          <div><dt>Ubicación</dt><dd>${esc(v.ubicacion)}</dd></div>
          <div><dt>Área</dt><dd>${esc(v.area)}</dd></div>
          <div><dt>Presupuesto</dt><dd>${esc(v.presupuesto)}</dd></div>
          <div><dt>Plazo de inicio</dt><dd>${esc(v.plazoInicio)}</dd></div>
          ${v.fecha ? `<div><dt>Enviada el</dt><dd>${esc(v.fecha)}</dd></div>` : ''}
        </dl>
        <p class="a-desc">${esc(v.descripcion)}</p>

        <h3 class="a-sect">Archivos del cliente</h3>
        ${htmlArchivos(d, estado)}
      </div>

      ${seccionCotizacion(v, d, estado)}`;
  }

  async function seleccionar(id) {
    const s = todas.find((x) => String(x.id) === String(id));
    if (!s) return;
    activa = s;
    pintarLista();

    if (cache.has(s.id)) return pintarDetalle(s, cache.get(s.id), 'ok');

    pintarDetalle(s, null, 'cargando');
    try {
      const d = await detalleSolicitudAdmin(s.id);
      cache.set(s.id, d);
      if (activa?.id === s.id) pintarDetalle(s, d, 'ok');
    } catch {
      if (activa?.id === s.id) pintarDetalle(s, null, 'error');
    }
  }

  // ── Carga inicial ──────────────────────────────────────────────────────
  async function cargar() {
    try {
      todas = await listarSolicitudesAdmin();
    } catch (err) {
      mensaje(err?.message || 'No pudimos cargar las solicitudes. Recarga la página.');
      return;
    }
    msg.hidden = true;
    cuerpo.hidden = false;
    pintarBadge();
    pintarLista();

    if (todas.length) seleccionar(todas[0].id);
    else pintarDetalle(null);
  }

  // ── Eventos ────────────────────────────────────────────────────────────
  tabsEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-filtro]');
    if (!b) return;
    filtro = b.dataset.filtro;
    pagina = 1;
    tabsEl.querySelectorAll('[data-filtro]').forEach((t) => t.setAttribute('aria-pressed', String(t === b)));
    pintarLista();
  });

  buscarEl.addEventListener('input', () => {
    texto = buscarEl.value;
    pagina = 1;
    pintarLista();
  });

  pagerEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-pag]');
    if (!b || b.disabled) return;
    pagina = Number(b.dataset.pag);
    pintarLista();
  });

  listaEl.addEventListener('click', (e) => {
    const b = e.target.closest('[data-id]');
    if (!b) return;
    seleccionar(b.dataset.id);
    if (window.matchMedia('(max-width: 1279px)').matches) {
      detalleEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });

  async function refrescar(id) {
    cache.clear();
    todas = await listarSolicitudesAdmin();
    pintarBadge();
    await seleccionar(id);
  }

  detalleEl.addEventListener('click', async (e) => {
    if (e.target.closest('[data-cerrar]')) {
      activa = null;
      pintarLista();
      pintarDetalle(null);
      return;
    }

    const dl = e.target.closest('[data-descargar]');
    if (dl) {
      if (dl.disabled) return;
      const archivo = cache.get(activa?.id)?.archivos?.find((a) => String(a.id) === dl.dataset.descargar);
      if (!archivo) return;
      const nota = dl.querySelector('small');
      const original = nota.textContent;
      dl.disabled = true;
      nota.textContent = 'Descargando…';
      try {
        await descargarArchivo(archivo);
        nota.textContent = original;
      } catch (err) {
        nota.textContent = err?.message || 'No pudimos descargar el archivo.';
        nota.classList.add('a-err');
        setTimeout(() => { nota.textContent = original; nota.classList.remove('a-err'); }, 5000);
      }
      dl.disabled = false;
      return;
    }

    const btn = e.target.closest('[data-tomar]');
    if (!btn || btn.disabled) return;
    if (!window.confirm('¿Tomar esta solicitud? Pasará a “En evaluación” y quedarás como responsable.')) return;

    const id = btn.dataset.tomar;
    const caja = $('adm-error');
    btn.disabled = true;
    if (caja) caja.hidden = true;

    try {
      await tomarSolicitud(id);
    } catch (err) {
      btn.disabled = false;
      if (caja) {
        caja.hidden = false;
        caja.textContent = err?.message || 'No se pudo tomar la solicitud. Intenta de nuevo.';
      }
      return;
    }

    try {
      await refrescar(id);
    } catch {
      mensaje('La solicitud se tomó, pero no pudimos actualizar la lista. Recarga la página.');
    }
  });

  detalleEl.addEventListener('change', (e) => {
    if (e.target.name !== 'pdf') return;
    const txt = $('cot-pdf-txt');
    if (txt) txt.textContent = e.target.files[0]?.name ?? 'Adjuntar propuesta en PDF';
  });

  const idDe = (r) => {
    const id = r?.id ?? r?.archivo?.id ?? r?.cotizacion?.id;
    if (id === undefined || id === null) throw new Error('El servidor no devolvió el identificador esperado.');
    return id;
  };

  // Enviar cotización: (1) sube el PDF, (2) crea o completa la cotización, (3) la envía.
  // Al enviarla el backend pasa la solicitud de "En evaluación" a "Respondida".
  detalleEl.addEventListener('submit', async (e) => {
    const form = e.target.closest('#adm-form');
    if (!form) return;
    e.preventDefault();

    const caja = $('adm-form-error');
    const btn = $('cot-enviar');
    const etiqueta = btn.querySelector('span');
    const textoBtn = etiqueta.textContent;
    const el = form.elements;

    const fallo = (texto, campo) => {
      caja.hidden = false;
      caja.textContent = texto;
      el[campo]?.focus();
    };
    caja.hidden = true;

    const titulo = el.titulo.value.trim();
    const valor = Number(el.valor.value);
    const vigencia = Number(el.vigencia.value);
    const pdf = el.pdf.files[0] ?? null;

    if (!titulo) return fallo('Escribe un título para la propuesta.', 'titulo');
    if (!(valor > 0)) return fallo('Ingresa un valor mayor que cero.', 'valor');
    if (valor > 999999999999) return fallo('El valor es demasiado alto.', 'valor');
    if (!Number.isInteger(vigencia) || vigencia < 1 || vigencia > 365) {
      return fallo('La vigencia debe ser un número entero de días entre 1 y 365.', 'vigencia');
    }
    if (pdf && pdf.type !== 'application/pdf' && !/\.pdf$/i.test(pdf.name)) {
      return fallo('La propuesta adjunta debe ser un archivo PDF.', 'pdf');
    }

    const solicitudId = form.dataset.solicitud;
    const s = todas.find((x) => String(x.id) === String(solicitudId));
    if (!window.confirm(`¿Enviar la cotización por ${fmtMoneda(valor)} a ${s ? nombreDe(s) : 'el cliente'}? La solicitud pasará a “Respondida”.`)) return;

    const bloquear = (si) => form.querySelectorAll('input, select, textarea, button').forEach((c) => { c.disabled = si; });
    bloquear(true);

    const sid = String(solicitudId);
    const previo = intentos.get(sid) ?? { id: form.dataset.cotizacion || null, archivoId: form.dataset.archivo || null };
    let cotizacionId = previo.id;
    let archivoId = previo.archivoId;
    try {
      if (pdf) {
        etiqueta.textContent = 'Subiendo PDF…';
        archivoId = idDe(await subirPropuestaPdf(solicitudId, pdf));
      }

      // El backend reescribe todos los campos al editar: archivo_id debe viajar siempre.
      const datos = {
        titulo,
        valor,
        moneda: 'COP',
        iva_incluido: el.iva.value === '1',
        vigencia_dias: vigencia,
        mensaje: el.mensaje.value.trim() || null,
        archivo_id: archivoId ? Number(archivoId) : null,
      };

      etiqueta.textContent = 'Guardando…';
      if (cotizacionId) {
        await actualizarCotizacion(cotizacionId, datos);
      } else {
        cotizacionId = idDe(await crearCotizacion(solicitudId, datos));
      }
      intentos.set(sid, { id: cotizacionId, archivoId }); // por si falla el envío y se reintenta

      etiqueta.textContent = 'Enviando…';
      await enviarCotizacion(cotizacionId);
    } catch (err) {
      bloquear(false);
      etiqueta.textContent = textoBtn;
      fallo(err?.message || 'No pudimos enviar la cotización. Intenta de nuevo.');
      return;
    }

    intentos.delete(String(solicitudId));
    try {
      await refrescar(solicitudId);
    } catch {
      mensaje('La cotización se envió, pero no pudimos actualizar la lista. Recarga la página.');
    }
  });

  // ── Sesión: pedir datos solo cuando hay usuario autenticado ────────────
  function alCambiarSesion(sesion) {
    if (sesion.status !== 'authenticated' || cargado) return;
    cargado = true;
    cargar();
  }
  alCambiarSesion(getSesion());
  suscribirSesion(alCambiarSesion);
</script>

