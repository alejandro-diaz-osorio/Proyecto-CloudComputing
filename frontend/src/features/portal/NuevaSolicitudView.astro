---
import { ArrowLeft, ArrowRight, Building2, Check, House, Lightbulb, MapPin, Paperclip, ShieldCheck, Store } from '@lucide/astro';
import SolPanel from './components/SolPanel.astro';
import { RUTAS } from '../../lib/routes.js';
import { TIPOS, PRESUPUESTOS, PLAZOS, LIMITES } from './solicitud.js';

const ICONOS = { vivienda: House, comercial: Store, otro: Building2 };
const PASOS = ['Tu idea', 'Datos del proyecto', 'Revisar solicitud', 'Evaluación humana'];
---

<section class="nueva" id="nueva">
  <div class="n-nav">
    <a class="n-back" href={RUTAS.portalCotizaciones}><ArrowLeft size={14} strokeWidth={1.8} /> Mis cotizaciones</a>
    <span class="n-saved" id="n-guardado" hidden><Check size={14} strokeWidth={2.2} /> Borrador guardado</span>
  </div>

  <div class="n-top">
    <div>
      <p class="n-eyebrow">Nueva solicitud</p>
      <h1>Cuéntanos sobre tu proyecto</h1>
      <p class="n-sub">No necesitas conocer términos técnicos. Describe tu idea con tus propias palabras.</p>
    </div>
    <div class="n-human">
      <ShieldCheck size={20} strokeWidth={1.6} />
      <div><b>Revisión humana garantizada</b><small>Un arquitecto validará tu solicitud antes de cotizar</small></div>
    </div>
  </div>

  <ol class="n-tabs" id="n-tabs" aria-label="Progreso de la solicitud">
    {PASOS.map((p, i) => (
      <li class="n-tab" data-tab={i + 1} data-estado={i === 0 ? 'current' : 'todo'}>
        <span class="n-tab__dot">{String(i + 1).padStart(2, '0')}</span>
        <b>{p}</b>
      </li>
    ))}
  </ol>

  <div class="n-cols" id="n-cols">
    <div class="n-card">
      <p class="n-alert" id="n-alerta" role="alert" hidden></p>

      <form id="n-form" novalidate>
        <!-- ── Paso 1 ─────────────────────────────────────────── -->
        <div class="n-panel" data-panel="1">
          <header class="n-head">
            <p class="n-step">Paso 1 de 4</p>
            <h2>Empecemos por tu idea</h2>
            <p class="n-lead">Entre más contexto compartas, mejor podremos entender lo que necesitas.</p>
          </header>

          <fieldset class="n-field">
            <legend class="n-label">¿Qué tipo de proyecto tienes en mente?</legend>
            <div class="n-tipos">
              {TIPOS.map((t, i) => {
                const Ico = ICONOS[t.id];
                return (
                  <label class="n-tipo">
                    <input type="radio" name="tipo" value={t.id} checked={i === 0} />
                    <span class="n-tipo__ico"><Ico size={22} strokeWidth={1.5} /></span>
                    <span class="n-tipo__txt"><b>{t.label}</b><small>{t.hint}</small></span>
                    <i class="n-radio" aria-hidden="true"></i>
                  </label>
                );
              })}
            </div>
            <p class="n-err" data-err="tipo" hidden></p>
          </fieldset>

          <div class="n-field">
            <div class="n-labelrow">
              <label class="n-label" for="n-desc">Describe lo que imaginas para tu proyecto</label>
              <small>No te preocupes por usar palabras técnicas</small>
            </div>
            <textarea id="n-desc" class="n-input n-textarea" rows="6" maxlength={LIMITES.descripcionMax}
              placeholder="Ej.: Quiero construir una casa campestre para mi familia, con espacios abiertos, mucha luz y conectada al jardín…"></textarea>
            <div class="n-counter"><small id="n-cuenta">0 caracteres</small></div>
            <p class="n-err" data-err="descripcion" hidden></p>
          </div>

          <div class="n-hint">
            <Lightbulb size={16} strokeWidth={1.6} />
            <b>Te puede ayudar mencionar:</b>
            <span>Quiénes usarán el espacio</span>
            <span>Qué ambientes necesitas</span>
            <span>Qué sensación buscas</span>
            <span>Referencias que te gustan</span>
          </div>

          <div class="n-field">
            <label class="n-drop" id="n-drop">
              <span class="n-drop__ico"><Paperclip size={20} strokeWidth={1.6} /></span>
              <span class="n-drop__txt"><b>Agrega planos o referencias</b><small>PDF · Máximo 10 MB por archivo</small></span>
              <span class="n-drop__btn">Seleccionar archivos</span>
              <input type="file" id="n-archivos" accept=".pdf,application/pdf" multiple hidden />
            </label>
            <ul class="n-files" id="n-lista-archivos"></ul>
            <p class="n-err" data-err="archivos" hidden></p>
          </div>

          <footer class="n-actions">
            <button type="button" class="n-btn n-btn--ghost" data-accion="salir">Guardar y salir</button>
            <button type="button" class="n-btn n-btn--primary" data-accion="ir2">Continuar con los datos <ArrowRight size={16} strokeWidth={2} /></button>
          </footer>
        </div>

        <!-- ── Paso 2 ─────────────────────────────────────────── -->
        <div class="n-panel" data-panel="2" hidden>
          <header class="n-head">
            <p class="n-step">Paso 2 de 4</p>
            <h2>Completa los datos principales</h2>
            <p class="n-lead">Puedes dejar en blanco cualquier dato que todavía no conozcas.</p>
          </header>

          <div class="n-grid">
            <div class="n-field">
              <label class="n-label" for="n-ubic">Ubicación del proyecto</label>
              <div class="n-icon-input">
                <MapPin size={16} strokeWidth={1.6} />
                <input id="n-ubic" class="n-input" type="text" maxlength={LIMITES.ubicacionMax} placeholder="Ej.: El Retiro, Antioquia" autocomplete="off" />
              </div>
              <p class="n-err" data-err="ubicacion" hidden></p>
            </div>

            <div class="n-field">
              <label class="n-label" for="n-area">Área aproximada</label>
              <div class="n-suffix-input">
                <input id="n-area" class="n-input" type="text" inputmode="decimal" placeholder="Ej.: 120" autocomplete="off" />
                <span>m²</span>
              </div>
              <small class="n-help">Puede ser un estimado</small>
              <p class="n-err" data-err="area" hidden></p>
            </div>

            <div class="n-field">
              <label class="n-label" for="n-pres">Presupuesto disponible</label>
              <select id="n-pres" class="n-input n-select">
                {PRESUPUESTOS.map((r) => <option value={r.id}>{r.label}</option>)}
              </select>
            </div>

            <div class="n-field">
              <label class="n-label" for="n-plazo">¿Cuándo te gustaría comenzar?</label>
              <select id="n-plazo" class="n-input n-select">
                {PLAZOS.map((p) => <option value={p.id}>{p.label}</option>)}
              </select>
            </div>
          </div>

          <fieldset class="n-field">
            <legend class="n-label">¿Qué servicios necesitas?</legend>
            <div class="n-chips" id="n-servicios"><small class="n-help">Cargando servicios…</small></div>
            <small class="n-help">Elige al menos uno; puedes marcar varios.</small>
            <p class="n-err" data-err="servicios" hidden></p>
          </fieldset>

          <footer class="n-actions">
            <button type="button" class="n-btn n-btn--ghost" data-accion="ir1">Anterior</button>
            <button type="button" class="n-btn n-btn--primary" data-accion="ir3">Revisar solicitud <ArrowRight size={16} strokeWidth={2} /></button>
          </footer>
        </div>

        <!-- ── Paso 3 ─────────────────────────────────────────── -->
        <div class="n-panel" data-panel="3" hidden>
          <header class="n-head">
            <p class="n-step">Paso 3 de 4</p>
            <h2>Revisa tu solicitud</h2>
            <p class="n-lead">Verifica que todo esté bien antes de enviarla.</p>
          </header>

          <div class="n-note">
            <ShieldCheck size={20} strokeWidth={1.6} />
            <div><b>Un arquitecto de Solucia evaluará tu solicitud</b><small>Revisa la información y envíala cuando estés listo.</small></div>
          </div>

          <section class="n-sum">
            <header><h3><span>01</span> Idea del proyecto</h3><button type="button" data-ir="1">Editar</button></header>
            <p id="r-idea" class="n-sum__idea"></p>
          </section>

          <section class="n-sum">
            <header><h3><span>02</span> Datos principales</h3><button type="button" data-ir="2">Editar</button></header>
            <dl class="n-sum__grid">
              <div><dt>Tipo</dt><dd id="r-tipo"></dd></div>
              <div><dt>Ubicación</dt><dd id="r-ubic"></dd></div>
              <div><dt>Área estimada</dt><dd id="r-area"></dd></div>
              <div><dt>Presupuesto</dt><dd id="r-pres"></dd></div>
              <div><dt>Inicio</dt><dd id="r-plazo"></dd></div>
              <div><dt>Servicios</dt><dd id="r-serv"></dd></div>
              <div class="n-sum__wide"><dt>Archivos adjuntos</dt><dd id="r-arch"></dd></div>
            </dl>
          </section>

          <label class="n-confirm">
            <input type="checkbox" id="n-confirma" />
            <span>Confirmo que revisé la información y autorizo enviarla al equipo de Solucia para una evaluación humana.</span>
          </label>

          <footer class="n-actions">
            <button type="button" class="n-btn n-btn--ghost" data-accion="ir2-atras">Anterior</button>
            <button type="button" class="n-btn n-btn--primary" id="n-enviar" data-accion="enviar" disabled>Enviar a evaluación humana <ArrowRight size={16} strokeWidth={2} /></button>
          </footer>
        </div>
      </form>

      <!-- ── Paso 4 ───────────────────────────────────────────── -->
      <div class="n-panel n-done" data-panel="4" hidden>
        <span class="n-done__ico"><Check size={30} strokeWidth={2} /></span>
        <p class="n-step">Solicitud recibida</p>
        <h2>Tu proyecto ya está en manos del equipo</h2>
        <p class="n-lead">Creamos la solicitud <b id="n-codigo">—</b>. La evaluación y la cotización serán realizadas por un arquitecto de Solucia.</p>
        <span class="n-pill"><i></i>Enviada</span>
        <ol class="n-timeline">
          <li class="n-timeline__ok"><span><Check size={14} strokeWidth={2.4} /></span><div><b>Solicitud enviada</b><small>Completado ahora</small></div></li>
          <li><span>2</span><div><b>Evaluación humana</b><small>Tiempo estimado: 2 a 3 días hábiles</small></div></li>
          <li><span>3</span><div><b>Respuesta y cotización</b><small>Recibirás una notificación</small></div></li>
        </ol>
        <a class="n-btn n-btn--primary" href={RUTAS.portalCotizaciones}>Ver mis solicitudes <ArrowRight size={16} strokeWidth={2} /></a>
      </div>
    </div>

    <!-- Espacio de "Sol": todavía sin implementar -->
    <SolPanel />
  </div>

  <template id="ico-check"><Check size={14} strokeWidth={2.4} /></template>
</section>

<script>
  import { initSession, getSesion, suscribirSesion } from '../auth/session.js';
  import { RUTAS } from '../../lib/routes.js';
  import { crearBorrador, actualizarBorrador, enviarSolicitud, listarServicios, subirArchivo, eliminarArchivo } from './api.js';
  import {
    LIMITES, validarIdea, validarDatos, validarArchivo, construirPayload,
    rangoPorId, etiquetaTipo, etiquetaPlazo, parseArea, tamanoLegible,
  } from './solicitud.js';

  initSession(); // idempotente: este script corre antes que el del layout

  const $ = (id) => document.getElementById(id);
  const esc = (t) =>
    String(t ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const msgDe = (err, defecto) => err?.mensaje || err?.message || defecto;

  const form = $('n-form');
  const cols = $('n-cols');
  const alertaEl = $('n-alerta');

  const estado = {
    paso: 1,
    id: null,          // id del borrador (se crea al pasar del paso 1)
    codigo: null,
    catalogo: [],      // servicios activos [{id, nombre}]
    archivos: [],      // { uid, file, estado: pendiente|subiendo|ok|error, id, msg }
    ocupado: false,
    enviada: false,
  };
  let uid = 0;

  // ── Lectura del formulario ────────────────────────────────────────────
  function leer() {
    return {
      tipo: form.querySelector('input[name="tipo"]:checked')?.value ?? '',
      descripcion: $('n-desc').value,
      ubicacion: $('n-ubic').value,
      area: $('n-area').value,
      presupuesto: $('n-pres').value,
      plazo: $('n-plazo').value,
      servicios: [...document.querySelectorAll('#n-servicios input:checked')].map((i) => Number(i.value)),
    };
  }

  // ── Mensajes ──────────────────────────────────────────────────────────
  function alerta(texto) {
    alertaEl.hidden = !texto;
    alertaEl.textContent = texto ?? '';
    if (texto) alertaEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  function mostrarErrores(errores) {
    document.querySelectorAll('[data-err]').forEach((p) => {
      const m = errores[p.dataset.err];
      p.hidden = !m;
      p.textContent = m ?? '';
    });
    const primero = Object.keys(errores)[0];
    if (primero) document.querySelector(`[data-err="${primero}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    return Object.keys(errores).length === 0;
  }

  function marcarGuardado() {
    $('n-guardado').hidden = false;
  }

  // Ejecuta una acción asíncrona bloqueando el botón (evita doble envío) y mostrando el error si falla.
  async function correr(boton, textoOcupado, fn) {
    if (estado.ocupado) return;
    estado.ocupado = true;
    alerta(null);
    const original = boton?.innerHTML;
    if (boton) { boton.disabled = true; boton.textContent = textoOcupado; }
    try {
      await fn();
    } catch (err) {
      alerta(msgDe(err, 'No pudimos completar la acción. Inténtalo de nuevo.'));
    } finally {
      estado.ocupado = false;
      if (boton && !estado.enviada) {
        boton.innerHTML = original;
        boton.disabled = boton.id === 'n-enviar' ? !$('n-confirma').checked : false;
      }
    }
  }

  // ── Navegación entre pasos ────────────────────────────────────────────
  function irAPaso(n) {
    estado.paso = n;
    document.querySelectorAll('[data-panel]').forEach((p) => (p.hidden = Number(p.dataset.panel) !== n));
    document.querySelectorAll('.n-tab').forEach((t) => {
      const i = Number(t.dataset.tab);
      const st = n === 4 || i < n ? 'done' : i === n ? 'current' : 'todo';
      t.dataset.estado = st;
      t.querySelector('.n-tab__dot').innerHTML = st === 'done' ? ($('ico-check')?.innerHTML ?? '✓') : String(i).padStart(2, '0');
    });
    cols.classList.toggle('n-cols--solo', n === 4);
    alerta(null);
    $('nueva').scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  // ── Persistencia (borrador) ───────────────────────────────────────────
  async function guardar() {
    const payload = construirPayload(leer());
    if (estado.id) {
      await actualizarBorrador(estado.id, payload);
    } else {
      const r = await crearBorrador(payload);
      estado.id = r.id;
      estado.codigo = r.codigo ?? null;
    }
    marcarGuardado();
  }

  // ── Archivos ──────────────────────────────────────────────────────────
  function pintarArchivos() {
    const etiqueta = { pendiente: 'En espera', subiendo: 'Subiendo…', ok: 'Adjuntado', error: 'No se pudo subir' };
    $('n-lista-archivos').innerHTML = estado.archivos
      .map((a) => `
        <li class="n-file n-file--${a.estado}">
          <span class="n-file__name">${esc(a.file.name)}</span>
          <small>${tamanoLegible(a.file.size)} · ${esc(a.estado === 'error' && a.msg ? a.msg : etiqueta[a.estado])}</small>
          <button type="button" data-quitar="${a.uid}" aria-label="Quitar ${esc(a.file.name)}" ${a.estado === 'subiendo' ? 'disabled' : ''}>Quitar</button>
        </li>`)
      .join('');
  }

  async function subirPendientes() {
    for (const a of estado.archivos.filter((x) => x.estado === 'pendiente')) {
      a.estado = 'subiendo';
      pintarArchivos();
      try {
        const r = await subirArchivo(estado.id, a.file);
        a.id = r?.id ?? null;
        a.estado = 'ok';
      } catch (err) {
        a.estado = 'error';
        a.msg = msgDe(err, 'Error al subir');
      }
      pintarArchivos();
    }
  }

  function agregarArchivos(lista) {
    const errores = [];
    for (const file of [...lista]) {
      const problema = validarArchivo(file);
      if (problema) { errores.push(problema); continue; }
      if (estado.archivos.some((a) => a.file.name === file.name && a.file.size === file.size)) continue;
      if (estado.archivos.length >= LIMITES.archivosMax) { errores.push(`Solo puedes adjuntar hasta ${LIMITES.archivosMax} archivos.`); break; }
      estado.archivos.push({ uid: ++uid, file, estado: 'pendiente', id: null, msg: '' });
    }
    mostrarErrores({ ...(errores.length ? { archivos: errores.join(' ') } : {}) });
    pintarArchivos();
    if (estado.id) subirPendientes(); // si el borrador ya existe, se suben de una vez
  }

  async function quitarArchivo(id) {
    const a = estado.archivos.find((x) => x.uid === Number(id));
    if (!a) return;
    if (a.estado === 'ok' && a.id) {
      try { await eliminarArchivo(a.id); }
      catch (err) { alerta(msgDe(err, 'No pudimos quitar el archivo.')); return; }
    }
    estado.archivos = estado.archivos.filter((x) => x.uid !== a.uid);
    pintarArchivos();
  }

  // ── Servicios (catálogo público) ──────────────────────────────────────
  async function cargarServicios() {
    const caja = $('n-servicios');
    try {
      estado.catalogo = await listarServicios();
      caja.innerHTML = estado.catalogo.length
        ? estado.catalogo
            .map((s) => `<label class="n-chip"><input type="checkbox" value="${esc(s.id)}" /><span>${esc(s.nombre)}</span></label>`)
            .join('')
        : '<small class="n-help">No hay servicios disponibles por ahora.</small>';
    } catch (err) {
      caja.innerHTML = `<small class="n-help n-help--error">${esc(msgDe(err, 'No pudimos cargar los servicios. Recarga la página.'))}</small>`;
    }
  }

  // ── Resumen (paso 3) ──────────────────────────────────────────────────
  function pintarResumen() {
    const d = leer();
    const area = parseArea(d.area);
    const nombres = d.servicios.map((id) => estado.catalogo.find((s) => Number(s.id) === id)?.nombre).filter(Boolean);
    const adjuntos = estado.archivos.filter((a) => a.estado === 'ok').map((a) => a.file.name);
    $('r-idea').textContent = d.descripcion.trim();
    $('r-tipo').textContent = etiquetaTipo(d.tipo);
    $('r-ubic').textContent = d.ubicacion.trim() || '—';
    $('r-area').textContent = area ? `${new Intl.NumberFormat('es-CO').format(area)} m²` : '—';
    $('r-pres').textContent = rangoPorId(d.presupuesto).label;
    $('r-plazo').textContent = etiquetaPlazo(d.plazo);
    $('r-serv').textContent = nombres.join(', ') || '—';
    $('r-arch').textContent = adjuntos.join(', ') || 'Ninguno';
    $('n-confirma').checked = false;
    $('n-enviar').disabled = true;
  }

  // ── Acciones ──────────────────────────────────────────────────────────
  function irPaso2(boton) {
    if (!mostrarErrores(validarIdea(leer()))) return;
    return correr(boton, 'Guardando…', async () => {
      await guardar();
      await subirPendientes();
      irAPaso(2);
    });
  }

  function irPaso3(boton) {
    if (!mostrarErrores(validarDatos(leer()))) return;
    return correr(boton, 'Guardando…', async () => {
      await guardar();
      pintarResumen();
      irAPaso(3);
    });
  }

  function guardarYSalir(boton) {
    const d = leer();
    const errores = { ...validarIdea(d), ...validarDatos(d, { exigirServicios: false }) };
    if (!mostrarErrores(errores)) return;
    return correr(boton, 'Guardando…', async () => {
      await guardar();
      await subirPendientes();
      window.location.assign(RUTAS.portalCotizaciones);
    });
  }

  function enviar(boton) {
    if (!$('n-confirma').checked) return;
    if (estado.archivos.some((a) => a.estado === 'subiendo' || a.estado === 'pendiente')) {
      alerta('Espera a que terminen de subirse los archivos.');
      return;
    }
    return correr(boton, 'Enviando…', async () => {
      await guardar(); // deja el borrador al día antes de enviarlo
      const r = await enviarSolicitud(estado.id);
      estado.enviada = true;
      $('n-codigo').textContent = r?.codigo ?? estado.codigo ?? `#${estado.id}`;
      irAPaso(4);
    });
  }

  const ACCIONES = {
    ir1: () => irAPaso(1),
    'ir2-atras': () => irAPaso(2),
    ir2: irPaso2,
    ir3: irPaso3,
    salir: guardarYSalir,
    enviar,
  };

  // ── Eventos ───────────────────────────────────────────────────────────
  form.addEventListener('submit', (e) => e.preventDefault()); // Enter no envía nada

  // Al corregir un campo, su mensaje de error desaparece
  const CAMPO_ERR = { 'n-desc': 'descripcion', 'n-ubic': 'ubicacion', 'n-area': 'area', tipo: 'tipo' };
  const limpiarError = (e) => {
    const nombre = e.target.closest('#n-servicios') ? 'servicios' : CAMPO_ERR[e.target.id] ?? CAMPO_ERR[e.target.name];
    const p = nombre && document.querySelector(`[data-err="${nombre}"]`);
    if (p) { p.hidden = true; p.textContent = ''; }
  };
  form.addEventListener('input', limpiarError);
  form.addEventListener('change', limpiarError);

  form.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-accion]');
    if (btn) return ACCIONES[btn.dataset.accion]?.(btn);
    const ir = e.target.closest('[data-ir]');
    if (ir) return irAPaso(Number(ir.dataset.ir));
    const quitar = e.target.closest('[data-quitar]');
    if (quitar) quitarArchivo(quitar.dataset.quitar);
  });

  $('n-tabs').addEventListener('click', (e) => {
    const t = e.target.closest('.n-tab');
    if (t && estado.paso < 4 && Number(t.dataset.tab) < estado.paso) irAPaso(Number(t.dataset.tab));
  });

  $('n-desc').addEventListener('input', (e) => {
    const n = e.target.value.length;
    $('n-cuenta').textContent = `${new Intl.NumberFormat('es-CO').format(n)} caracteres`;
  });

  $('n-confirma').addEventListener('change', (e) => {
    $('n-enviar').disabled = !e.target.checked || estado.ocupado;
  });

  $('n-archivos').addEventListener('change', (e) => {
    agregarArchivos(e.target.files);
    e.target.value = ''; // permite volver a elegir el mismo archivo
  });

  const drop = $('n-drop');
  ['dragenter', 'dragover'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.add('is-over'); }));
  ['dragleave', 'drop'].forEach((ev) => drop.addEventListener(ev, (e) => { e.preventDefault(); drop.classList.remove('is-over'); }));
  drop.addEventListener('drop', (e) => agregarArchivos(e.dataTransfer?.files ?? []));

  // ── Sesión: pedir datos solo cuando hay usuario autenticado ───────────
  let iniciado = false;
  function alCambiarSesion(sesion) {
    if (sesion.status !== 'authenticated' || iniciado) return;
    iniciado = true;
    cargarServicios();
  }
  alCambiarSesion(getSesion());
  suscribirSesion(alCambiarSesion);
</script>

