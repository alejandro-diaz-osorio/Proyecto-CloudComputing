---
import { FileText, User, CircleHelp, LogOut } from '@lucide/astro';
import { NAV_PORTAL } from '../nav.js';

interface Props {
  pathname: string;
  items?: typeof NAV_PORTAL;
  titulo?: string;
}
const { pathname, items = NAV_PORTAL, titulo = 'Mi espacio' } = Astro.props;

const sinBarra = (ruta: string) => ruta.replace(/\/+$/, '');
const actual = sinBarra(pathname);
const activo = (href: string) => {
  const h = sinBarra(href);
  return actual === h || actual.startsWith(`${h}/`);
};

const ICONOS = { file: FileText, user: User };
---

<aside class="fixed bottom-0 left-0 top-[70px] z-20 flex w-[216px] flex-col border-r border-[#e7e1d4] bg-[#fffdf9] p-[28px_12px_16px] transition-transform max-lg:-translate-x-full group-data-[nav-open=true]:translate-x-0" id="portal-sidebar">
  <p class="mb-3.5 px-3 text-[10px] uppercase tracking-[.14em] text-[#8a8678]">{titulo}</p>

  <nav class="flex flex-col gap-1" aria-label="Menú del portal">
    {items.map((item) => {
      const Icono = ICONOS[item.icon];
      return (
        <a
          href={item.href}
          class:list={['relative flex items-center gap-3 rounded px-3 py-3 text-[13px] text-[#1d2433] no-underline hover:bg-[#f3efe6] before:absolute before:bottom-0 before:left-[-12px] before:top-0 before:w-[3px] before:bg-[#c0301f] before:content-[\'\']', { 'bg-[#f9e3df] text-[#c0301f]': activo(item.href) }]}
          aria-current={activo(item.href) ? 'page' : undefined}
        >
          <Icono size={18} strokeWidth={1.6} />
          {item.label}
        </a>
      );
    })}
  </nav>

  <div class="mt-auto flex flex-col gap-3.5">
    <div class="flex items-center gap-2.5 rounded-md border border-[#e7e1d4] p-3 text-[11px] text-[#8a8678]">
      <CircleHelp size={20} strokeWidth={1.6} />
      <div>
        <strong class="block font-semibold text-[#1d2433]">¿Necesitas ayuda?</strong>
        <a class="text-[#c0301f] no-underline" href="/nosotros">Contáctanos</a>
      </div>
    </div>
    <button type="button" class="flex items-center gap-2.5 border-0 bg-transparent px-3 py-2 text-xs text-[#8a8678] hover:text-[#1d2433]" id="portal-salir">
      <LogOut size={18} strokeWidth={1.6} />
      Cerrar sesión
    </button>
  </div>
</aside>