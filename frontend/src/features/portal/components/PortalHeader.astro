---
import { Menu, Bell, ChevronDown } from '@lucide/astro';
import { RUTAS } from '../../../lib/routes.js';
---

<header class="fixed inset-x-0 top-0 z-[30] flex h-[70px] items-center gap-4 border-b border-[#e7e1d4] bg-[#fffdf9] px-5">
  <button type="button" class="hidden border-0 bg-transparent text-[#1d2433] lg:hidden" data-nav-toggle aria-label="Abrir menú">
    <Menu size={22} strokeWidth={1.8} />
  </button>

  <a href={RUTAS.portal}>
    <img class="block h-[52px] w-auto max-sm:h-[42px]" src="/logo.png" alt="SOLUCIA · Diseño y construcción" />
  </a>

  <div class="ml-auto flex items-center gap-5">
    <button type="button" class="border-0 bg-transparent text-[#1d2433]" aria-label="Notificaciones">
      <Bell size={20} strokeWidth={1.6} />
    </button>
    <div class="flex items-center gap-2.5 text-[#8a8678]">
      <span class="grid size-9 place-items-center rounded-full bg-[#ece8df] text-xs font-bold text-[#1d2433]" data-user-initials>··</span>
      <span class="flex flex-col leading-tight max-sm:hidden">
        <strong class="text-[13px] font-semibold text-[#1d2433]" data-user-short>&nbsp;</strong>
        <small class="text-[11px] text-[#8a8678]" data-user-role>&nbsp;</small>
      </span>
      <ChevronDown size={16} strokeWidth={1.8} />
    </div>
  </div>
</header>