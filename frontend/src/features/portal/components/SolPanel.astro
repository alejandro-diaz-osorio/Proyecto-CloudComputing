---
// Espacio reservado para "Sol, asistente de proyecto". La IA aún no se implementa:
// solo deja el lugar (encabezado y un <slot/> vacío) para conectarla después sin tocar el layout.
import { Bot } from '@lucide/astro';
---

<aside class="sticky top-[90px] overflow-hidden border border-[#e7e1d4] bg-[#fffdf9] max-xl:hidden" aria-label="Asistente de proyecto (próximamente)" data-sol>
  <header class="flex items-center gap-3.5 bg-[#1d2433] p-[18px_20px] text-white">
    <span class="grid size-11 shrink-0 place-items-center rounded-md bg-[#2a3347] text-[#f4a99f]"><Bot size={22} strokeWidth={1.5} /></span>
    <div>
      <strong class="text-sm font-semibold">Sol, asistente de proyecto <em class="ml-1 rounded bg-[#e9e4f6] px-1.5 py-0.5 text-[9px] font-bold not-italic text-[#5b4a9a]">IA</em></strong>
      <small class="text-[11px] text-[#a9b1c4]">Próximamente</small>
    </div>
  </header>
  <div class="min-h-[360px]">
    <slot />
  </div>
</aside>