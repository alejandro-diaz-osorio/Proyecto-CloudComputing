---
// Espacio reservado para "Sol, asistente de proyecto". La IA aún no se implementa:
// solo deja el lugar (encabezado y un <slot/> vacío) para conectarla después sin tocar el layout.
import { Bot } from '@lucide/astro';
---

<aside class="sol" aria-label="Asistente de proyecto (próximamente)" data-sol>
  <header class="sol__head">
    <span class="sol__ico"><Bot size={22} strokeWidth={1.5} /></span>
    <div>
      <strong>Sol, asistente de proyecto <em>IA</em></strong>
      <small>Próximamente</small>
    </div>
  </header>
  <div class="sol__body">
    <slot />
  </div>
</aside>

<style>
  .sol { background: var(--p-card); border: 1px solid var(--p-line); overflow: hidden; position: sticky; top: 90px; }
  .sol__head { display: flex; align-items: center; gap: 14px; padding: 18px 20px; background: #1d2433; color: #fff; }
  .sol__ico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 6px; background: #2a3347; color: #f4a99f; flex: none; }
  .sol__head div { display: flex; flex-direction: column; gap: 4px; }
  .sol__head strong { font-size: 14px; font-weight: 600; }
  .sol__head em { font-style: normal; font-size: 9px; font-weight: 700; padding: 2px 5px; margin-left: 4px; border-radius: 3px; background: #e9e4f6; color: #5b4a9a; vertical-align: 1px; }
  .sol__head small { font-size: 11px; color: #a9b1c4; }
  .sol__body { min-height: 360px; }
  @media (max-width: 1099px) { .sol { display: none; } }
</style>