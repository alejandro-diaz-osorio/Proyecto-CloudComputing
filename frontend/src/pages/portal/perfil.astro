---
import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Mi perfil · SOLUCIA" rol="cliente">
  <section class="p-5 lg:p-[36px_48px_56px]">
    <p class="mb-1.5 text-[10px] font-bold uppercase tracking-[.14em] text-[#c0301f]">Área de cliente</p>
    <h1 class="mb-7 text-[clamp(1.9rem,3vw,2.6rem)] font-extrabold uppercase leading-tight tracking-tight">Mi perfil</h1>

    <dl class="grid max-w-[720px] grid-cols-1 gap-6 border border-[#e7e1d4] bg-[#fffdf9] p-7 sm:grid-cols-2">
      <div><dt class="mb-1 text-[11px] text-[#8a8678]">Nombre</dt><dd class="m-0 break-words text-sm font-semibold" data-perfil="nombre">—</dd></div>
      <div><dt class="mb-1 text-[11px] text-[#8a8678]">Correo electrónico</dt><dd class="m-0 break-words text-sm font-semibold" data-perfil="email">—</dd></div>
      <div><dt class="mb-1 text-[11px] text-[#8a8678]">Teléfono</dt><dd class="m-0 break-words text-sm font-semibold" data-perfil="telefono">—</dd></div>
      <div><dt class="mb-1 text-[11px] text-[#8a8678]">Tipo de cuenta</dt><dd class="m-0 break-words text-sm font-semibold">Cliente</dd></div>
    </dl>
  </section>
</PortalLayout>

<script>
  import { getSesion, suscribirSesion } from '../../features/auth/session.js';

  function pintar(sesion: any) {
    const u = sesion?.user;
    if (sesion?.status !== 'authenticated' || !u) return;
    const set = (campo: string, valor: string) => {
      const el = document.querySelector(`[data-perfil="${campo}"]`);
      if (el) el.textContent = valor || '—';
    };
    set('nombre', [u.nombre, u.apellido].filter(Boolean).join(' '));
    set('email', u.email);
    set('telefono', u.telefono);
  }

  pintar(getSesion());
  suscribirSesion(pintar);
</script>
