---
// Panel izquierdo (estático, sin JavaScript). Reemplaza el SVG del logo por tu archivo real.
interface Props {
  mode?: "login" | "registro"
}

const { mode = "login" } = Astro.props

const pasos = [
  { n: "01", titulo: "Describe tu idea", sub: "Sin términos técnicos" },
  { n: "02", titulo: "Evaluación profesional", sub: "Por un arquitecto" },
  { n: "03", titulo: "Recibe tu cotización", sub: "Clara y detallada" },
]
---

<aside
  class="auth-hero"
  data-mode={mode}
>
  <div class="auth-hero__top">
    <a
      class="auth-brand"
      href="/"
      aria-label="SOLUCIA, ir al inicio"
    >
      <img
        class="block w-40 max-w-full h-auto max-sm:w-32 px-4 py-2 bg-linear-to-r from-white/30 to-white/60 rounded-full"
        src="/logo.png"
        alt="SOLUCIA · Diseño y construcción"
      />
    </a>
    <a
      class="auth-pill"
      href="/"
      >Portal de proyectos</a
    >
  </div>

  <div class="auth-hero__content">
    <p class="auth-hero__eyebrow"><span></span>Tu proyecto, paso a paso</p>
    <p class="auth-hero__title">
      Construimos confianza <em>desde la primera idea.</em>
    </p>
    <p class="auth-hero__lead">
      Un espacio claro para organizar tu proyecto, conversar con nuestro equipo
      y seguir cada avance hasta recibir tu cotización.
    </p>
    <ol class="auth-steps">
      {
        pasos.map((p) => (
          <li>
            <span class="auth-steps__n">{p.n}</span>
            <span>
              <>
                <strong>{p.titulo}</strong>
                <small>{p.sub}</small>
              </>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</aside>
