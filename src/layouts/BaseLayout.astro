---
import "../styles/global.css"

interface Props {
	title?: string
	description?: string
}

const {
	title = "SOLUCIA - Diseño y Construcción",
	description = "SOLUCIA S.A.S. integra arquitectura, cálculo estructural, urbanismo y ejecución de obra.",
} = Astro.props
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link
			rel="icon"
			href="/favicon.ico"
		/>
		<meta
			name="viewport"
			content="width=device-width"
		/>
		<meta
			name="description"
			content={description}
		/>
		<meta
			name="generator"
			content={Astro.generator}
		/>
		<title>{title}</title>
	</head>
	<body class="bg-[#f5f3ec] font-sans text-slate-800 antialiased">
		<slot />
	</body>
</html>
