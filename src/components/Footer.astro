---

---

<footer
	id="contacto"
	class="bg-slate-900 text-white"
>
	<div
		class="mx-auto grid max-w-7xl gap-8 px-4 py-12 sm:gap-10 sm:px-6 sm:py-14 md:grid-cols-2 lg:grid-cols-4"
	>
		<!-- Columna 1: Marca e info -->
		<div class="space-y-4 lg:col-span-1">
			<img
				src="/logo.png"
				alt="SOLUCIA S.A.S."
				class="h-8 brightness-0 invert"
			/>
			<p class="max-w-xs text-sm leading-relaxed text-slate-300">
				Diseñamos y construimos espacios que conectan visión, técnica y
				territorio.
			</p>
			<a
				href="mailto:arquitectasolucia@gmail.com"
				class="inline-block text-sm font-medium text-[#c23b22] transition-colors hover:text-white"
			>
				arquitectasolucia@gmail.com
			</a>
		</div>

		<!-- Columna 2: Navegación -->
		<div>
			<h2
				class="mb-4 text-xs font-bold uppercase tracking-wider text-white"
			>
				Explora
			</h2>
			<nav
				class="space-y-3 text-sm text-slate-300"
				aria-label="Navegación del pie de página"
			>
				<a
					href="/"
					class="block transition-colors hover:text-[#c23b22]"
				>
					Inicio
				</a>
				<a
					href="/servicios/"
					class="block transition-colors hover:text-[#c23b22]"
				>
					Servicios
				</a>
				<a
					href="/cotizar/"
					class="block transition-colors hover:text-[#c23b22]"
				>
					Contacto
				</a>
			</nav>
		</div>

		<!-- Columna 3: Mapa Google Maps -->
		<div class="overflow-hidden rounded-lg">
			<iframe
				src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d475.61539794349574!2d-75.69334803830232!3d4.811826417227746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8e388747c97422b7%3A0x2432b4581127aa57!2sEdificio%20Torre%20Central%2C%20Pereira%2C%20Risaralda!5e1!3m2!1ses-419!2sco!4v1789451637477!5m2!1ses-419!2sco"
				class="h-36 w-full rounded-lg border-0 sm:h-40"
				loading="lazy"
				referrerpolicy="strict-origin-when-cross-origin"
				title="Ubicación SOLUCIA S.A.S. - Edificio Torre Central, Pereira"
			></iframe>
		</div>

		<!-- Columna 4: CTA Cotización -->
		<div
			class="border-t border-slate-800 pt-6 lg:border-l lg:border-t-0 lg:pl-6 lg:pt-0"
		>
			<p class="mb-4 text-sm leading-relaxed text-slate-300">
				¿Tienes un proyecto en mente? Hablemos de cómo hacerlo realidad.
			</p>
			<a
				href="/cotizar/"
				class="inline-block rounded-lg bg-[#c23b22] px-5 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition-colors hover:bg-red-700"
			>
				COTIZAR PROYECTO
			</a>
		</div>
	</div>

	<!-- Copyright -->
	<div class="border-t border-slate-800">
		<div
			class="mx-auto flex max-w-7xl flex-col gap-2 px-4 py-5 text-xs leading-relaxed text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-6"
		>
			<p>
				© {new Date().getFullYear()} SOLUCIA S.A.S. Todos los derechos reservados.
			</p>
			<p>
				Diseñado y desarrollado por <strong
					><a
						href="/"
						target="_blank"
						class="transition-colors hover:text-[#c23b22]"
						>Sixtemas & Tecnología</a
					></strong
				>
			</p>
		</div>
	</div>
</footer>
